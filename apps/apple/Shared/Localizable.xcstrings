    "settings.devices.labels.adminBody": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台机器上的程序将能做你在网页上能做的一切，包括删除媒体文件。只在你清楚这台机器上正在运行什么程序时才批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "这台机器上的程序将能做你在网页上能做的一切，包括删除媒体文件。只在你清楚这台机器上正在运行什么程序时才批准。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The program on this machine can do everything you can do on the website, including deleting media files. Only approve if you know what program is running on this machine."
          }
        }
      }
    },
    "settings.devices.labels.memberTitle": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
