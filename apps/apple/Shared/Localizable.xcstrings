    "settings.webhookUi.intro": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放、收藏等事件发生后，MovieClaw 会向下面配置的地址推送 JSON（自有协议带 HMAC-SHA256 签名，头 X-MovieClaw-Signature），供 Home Assistant、观影记录等外部服务实时订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放、收藏等事件发生后，MovieClaw 会向下面配置的地址推送 JSON（自有协议带 HMAC-SHA256 签名，头 X-MovieClaw-Signature），供 Home Assistant、观影记录等外部服务实时订阅。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When events such as playback and favorites occur, MovieClaw sends JSON to the addresses below (the native protocol is signed with HMAC-SHA256 in the X-MovieClaw-Signature header) so services such as Home Assistant or watch trackers can subscribe in real time."
          }
        }
      },
      "comment": "Webhook settings."
    },
