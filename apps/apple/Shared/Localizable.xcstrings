          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cannot establish a secure HTTPS connection to %@. If the server does not use HTTPS, start the address with http://."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mit %@ konnte keine sichere HTTPS-Verbindung hergestellt werden. Falls der Server kein HTTPS nutzt, beginne die Adresse mit http://."
