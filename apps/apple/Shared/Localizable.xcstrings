    "settings.playback.clips.offPitch": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台把每部影片的精彩片段提前转成 1080p 小文件。开启后，电视首页和详情页的大图预告起播快、不卡顿，刷片更流畅，外网刷片也不用实时转码。首次开启要在后台处理一段时间（有人观看时自动暂停），每部约占 20 MB。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "后台把每部影片的精彩片段提前转成 1080p 小文件。开启后，电视首页和详情页的大图预告起播快、不卡顿，刷片更流畅，外网刷片也不用实时转码。首次开启要在后台处理一段时间（有人观看时自动暂停），每部约占 20 MB。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre-encode each title’s highlights as small 1080p files. TV hero trailers then start quickly without stutter, reels play more smoothly, and watching reels away from home needs no live transcoding. The first pass runs in the background for a while (paused while someone watches) and takes about 20 MB per title."
          }
        }
      },
      "comment": "Clips footer."
    },
