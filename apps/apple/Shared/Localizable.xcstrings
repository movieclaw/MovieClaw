    "library.transfer.crossDiskTail": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：文件需要完整复制（%@），耗时取决于体积与盘速；复制会产生新文件，与下载器做种目录的硬链接关系将断开，两边各占一份空间。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "：文件需要完整复制（%@），耗时取决于体积与盘速；复制会产生新文件，与下载器做种目录的硬链接关系将断开，两边各占一份空间。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ". Files must be copied in full (%@); the time depends on file size and disk speed. Copying creates new files, breaks hard links with the downloader’s seeding directory, and uses space in both places."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
