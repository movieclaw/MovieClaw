    "settings.logsUi.storageHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "日志按天存档在服务端 data/logs 目录（Docker 部署挂载 data 卷即可持久化），超过保留天数的旧日志会自动清理；保留天数与目录位置可通过 LOG_RETENTION_DAYS、LOG_DIR 环境变量调整。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "日志按天存档在服务端 data/logs 目录（Docker 部署挂载 data 卷即可持久化），超过保留天数的旧日志会自动清理；保留天数与目录位置可通过 LOG_RETENTION_DAYS、LOG_DIR 环境变量调整。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logs are archived daily in the server’s data/logs directory (mount the data volume in Docker to keep them). Logs past the retention period are removed automatically; set the retention and location with the LOG_RETENTION_DAYS and LOG_DIR environment variables."
          }
        }
      },
      "comment": "Settings."
    },
    "settings.mcpUi.intro": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "端点是给 AI 客户端用的入口：建一个、勾选要开放的服务，Claude Code 或 Cursor 填上地址和令牌，就能直接查库存、搜资源、管订阅。每个端点的工具目录相互独立。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "端点是给 AI 客户端用的入口：建一个、勾选要开放的服务，Claude Code 或 Cursor 填上地址和令牌，就能直接查库存、搜资源、管订阅。每个端点的工具目录相互独立。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Endpoints are entry points for AI clients: create one, choose the services to expose, then enter its address and token in Claude Code or Cursor to check your library, search releases and manage subscriptions. Each endpoint has its own tool catalog."
          }
        }
      },
      "comment": "Settings."
    },
