        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are connected through port %1$@ while the server listens on %2$@, so a port mapping or reverse proxy is in between. "
          }
        }
      },
      "comment": "Confirmation detail; followed by the main text."
    },
    "settings.networkUi.restartConfirm": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器将重启并监听端口 %@，当前地址可能失效。%@Docker bridge 部署必须同步修改 compose 中 ports 的容器侧端口并重建容器；反向代理必须调整目标端口。只想改变访问端口时，可直接调整映射或反向代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器将重启并监听端口 %@，当前地址可能失效。%@Docker bridge 部署必须同步修改 compose 中 ports 的容器侧端口并重建容器；反向代理必须调整目标端口。只想改变访问端口时，可直接调整映射或反向代理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server will restart and listen on port %1$@, and the current address may stop working. %2$@With Docker bridge networking, also change the container-side port in compose and recreate the container; update the reverse proxy’s target port. To change only the port you connect through, adjust the mapping or reverse proxy instead."
          }
        }
      },
      "comment": "Confirmation message."
    },
