    "settings.devicesUi.adminTokenBody": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台机器上的程序将以你的身份操作，能做你在网页上能做的一切。只在你清楚这台机器上正在运行什么程序时才批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "这台机器上的程序将以你的身份操作，能做你在网页上能做的一切。只在你清楚这台机器上正在运行什么程序时才批准。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Programs on this machine will act as you and can do anything you can do on the website. Only approve if you know what is running on this machine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Programme auf diesem Gerät handeln in deinem Namen. Sie können alles tun, was du auch auf der Website tun kannst. Bestätige nur, wenn du weißt, welche Programme auf diesem Gerät laufen."
          }
        }
      },
      "comment": "Devices settings."
    },
    "settings.devicesUi.transcodeTokenBody": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "给命令行模式（Headless）的转码器用：只能连转码链路，不能查看或修改你的订阅、媒体库和设置。令牌不会自动过期，只能在这里注销。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "给命令行模式（Headless）的转码器用：只能连转码链路，不能查看或修改你的订阅、媒体库和设置。令牌不会自动过期，只能在这里注销。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "For transcoders in headless mode: it can only use the transcoding link and cannot view or change your subscriptions, libraries or settings. The token does not expire; revoke it here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für Transcoder im Headless-Modus. Das Token erlaubt nur den Zugriff auf die Transkodierung. Abos, Mediatheken und Einstellungen bleiben unzugänglich. Das Token läuft nicht ab und kann hier widerrufen werden."
          }
        }
      },
      "comment": "Devices settings."
    },
