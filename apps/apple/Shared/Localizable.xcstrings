    "settings.pushChannels.introLead": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入的通道是你的通知渠道，收哪些通知和手机 App 一样，在「通知」里设置。能对话的通道里还能直接和 AI 助手聊：发消息即可搜片、订阅、查进度。发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接入的通道是你的通知渠道，收哪些通知和手机 App 一样，在「通知」里设置。能对话的通道里还能直接和 AI 助手聊：发消息即可搜片、订阅、查进度。发送"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected channels deliver your notifications; choose which ones in Notifications, just like the phone app. In channels that support chat, message the AI assistant to search, subscribe or check progress. Send"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verknüpfte Kanäle erhalten deine Mitteilungen. Wie in der iPhone-App legst du unter „Mitteilungen“ fest, welche du erhältst. In Kanälen mit Chat kannst du den KI-Assistenten nach Titeln suchen, Abos anlegen oder den Fortschritt prüfen lassen. Sende"
          }
        }
      },
      "comment": "Before /reset."
    },
    "settings.pushChannels.introMiddle": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重置会话，"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重置会话，"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "to reset the conversation, or"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "um die Unterhaltung zurückzusetzen, oder"
          }
        }
      },
      "comment": "Between /reset and /stop."
    },
    "settings.pushChannels.introTail": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消正在进行的处理。通道由插件提供，可以在网页的「设置 → 插件」里安装更多通道。"
