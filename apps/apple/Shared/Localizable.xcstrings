{
  "sourceLanguage": "zh-Hans",
  "strings": {
    "offline.waitingWifi": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等待 Wi-Fi"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等待 Wi-Fi"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Waiting for Wi-Fi"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf WLAN"
          }
        }
      },
      "comment": "Offline download waiting for Wi-Fi."
    },
    "offline.waitingWifiHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在用蜂窝网络、个人热点或低数据模式，下载会等连上 Wi-Fi 再继续"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "正在用蜂窝网络、个人热点或低数据模式，下载会等连上 Wi-Fi 再继续"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You're on cellular, a hotspot, or Low Data Mode. Downloads will continue on Wi-Fi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du nutzt Mobilfunk, einen Hotspot oder den Datensparmodus. Die Downloads werden im WLAN fortgesetzt."
          }
        }
      },
      "comment": "Offline download waiting for Wi-Fi."
    },
