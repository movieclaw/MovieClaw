    "settings.playback.cache.on": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "续播、重看时复用已转码内容。按可用空间自动限额，24 小时未用自动清理，也可在「更新与维护 → 缓存管理」中清空。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "续播、重看时复用已转码内容。按可用空间自动限额，24 小时未用自动清理，也可在「更新与维护 → 缓存管理」中清空。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resuming and rewatching reuse transcoded content. The cache is limited by free space, cleared after 24 hours unused, and can be emptied in Updates & Maintenance → Cache."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiedergabe und erneute Abspielung nutzen bereits transkodierte Inhalte. Der Cache ist begrenzt durch freien Speicherplatz, wird nach 24 Stunden ohne Nutzung geleert und kann im Menü „Aktualisierungen & Wartung → Cache“ geleert werden."
          }
        }
      },
      "comment": "Playback settings."
    },
    "settings.playback.cache.off": {
