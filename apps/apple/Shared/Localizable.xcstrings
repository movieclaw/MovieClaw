          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Keep all files in %lld unit and stop listing them as duplicates. Files stay in place; you can undo this per file on the item details page."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Keep all files in %lld units and stop listing them as duplicates. Files stay in place; you can undo this per file on the item details page."
