    "activity.watch.endExplanation": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备正在进行的播放会立刻中断，一分钟内不能续播；登录凭据与观看进度都不受影响，之后重新点播放即可继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备正在进行的播放会立刻中断，一分钟内不能续播；登录凭据与观看进度都不受影响，之后重新点播放即可继续。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Playback on this device stops immediately and cannot resume for one minute. Sign-in credentials and watch progress are kept. Select play again afterward to continue."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergabe auf diesem Gerät stoppt sofort und kann eine Minute lang nicht fortgesetzt werden. Anmeldedaten und Wiedergabefortschritt bleiben erhalten. Danach einfach erneut auf Abspielen tippen, um weiterzuschauen."
          }
        }
      },
      "comment": "End playback dialog."
    },
    "activity.watch.revokeExplanation": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」的登录凭据会立刻失效，正在进行的播放与下载一并停止，该设备下次使用需要重新登录。\n\n已看进度、收藏这些观看记录按账号保存，不会因为注销设备而丢失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」的登录凭据会立刻失效，正在进行的播放与下载一并停止，该设备下次使用需要重新登录。\n\n已看进度、收藏这些观看记录按账号保存，不会因为注销设备而丢失。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-in credentials for “%@” become invalid immediately. Playback and downloads stop, and the device must sign in again next time.\n\nWatch progress and favorites are saved to the account and are not lost when the device is signed out."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anmeldedaten für „%@“ werden sofort ungültig. Wiedergabe und Downloads stoppen. Das Gerät muss sich beim nächsten Zugriff erneut anmelden.\n\nWiedergabefortschritt und Favoriten bleiben nach der Abmeldung im Konto gespeichert."
          }
        }
      },
      "comment": "Sign out device dialog."
    },
