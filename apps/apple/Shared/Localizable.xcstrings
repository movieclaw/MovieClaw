    "settings.mcpForm.expandedHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每条命令作为独立工具，模型直接填写参数。工具较多时可以改用折叠。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每条命令作为独立工具，模型直接填写参数。工具较多时可以改用折叠。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each command is a separate tool and the model fills in its parameters. Use collapsed mode when there are many tools."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Befehl ist ein eigenes Werkzeug und das Modell füllt die Parameter aus. Nutze den eingerückten Modus, wenn viele Werkzeuge vorhanden sind."
          }
        }
      },
      "comment": "Settings."
    },
    "settings.mcpForm.collapsedHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个服务作为一个工具，调用时指定命令与参数，减少上下文占用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每个服务作为一个工具，调用时指定命令与参数，减少上下文占用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each service is one tool; calls specify the command and parameters, using less context."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Dienstleistung ist ein Werkzeug; Aufrufe spezifizieren den Befehl und die Parameter und nutzen weniger Kontext."
          }
        }
      },
      "comment": "Settings."
    },
    "settings.mcpForm.riskHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾中的服务，接进来的模型就能全部执行，和你自己在命令行上能做的一样——勾了「library」它就可以删除磁盘上的媒体文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "勾中的服务，接进来的模型就能全部执行，和你自己在命令行上能做的一样——勾了「library」它就可以删除磁盘上的媒体文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connected models can run everything in the selected services, just like you on the command line. Selecting library lets them delete media files on disk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbundene Modelle können in den ausgewählten Diensten dieselben Aktionen ausführen wie du auf der Kommandozeile. Wenn du „Mediathek“ auswählst, können sie Mediendateien vom Laufwerk löschen."
          }
        }
      },
      "comment": "Settings."
    },
