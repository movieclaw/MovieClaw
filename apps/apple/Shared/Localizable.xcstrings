    "library.issues.ignoreGroupHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "之后扫描不再过问（不动磁盘；可在「已忽略」里恢复）。适合自录、花絮这类 TMDB 本就不会有条目的内容——只是暂时认不出的建议先搜索认领。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "之后扫描不再过问（不动磁盘；可在「已忽略」里恢复）。适合自录、花絮这类 TMDB 本就不会有条目的内容——只是暂时认不出的建议先搜索认领。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Future scans will skip these files. Disk files are untouched; restore them under Ignored. This suits home recordings and extras absent from TMDB. If identification only failed temporarily, try searching and assigning an identity first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Künftige Scans überspringen diese Dateien. Dateien auf der Festplatte bleiben unberührt; unter „Ignoriert“ kannst du sie wiederherstellen. Das eignet sich für Heimaufnahmen und Extras, die es auf TMDB nicht gibt. Ist die Identifizierung nur vorübergehend fehlgeschlagen, versuche zuerst, zu suchen und eine Zuordnung vorzunehmen."
          }
        }
      }
    },
