    "settings.profile.clearHistoryDescription": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有作品的续播进度、已看标记和播放次数都会清除，首页「最近观看」与播放器的「继续观看」随即清空，无法恢复。只影响你自己的记录；应用更新前的自动备份仍包含历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有作品的续播进度、已看标记和播放次数都会清除，首页「最近观看」与播放器的「继续观看」随即清空，无法恢复。只影响你自己的记录；应用更新前的自动备份仍包含历史记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently clears resume positions, watched markers and play counts for all titles, including Recently watched on the home page and Continue watching in the player. Only your own history is affected. Automatic backups from before app updates still contain the history."
          }
        }
      }
    },
