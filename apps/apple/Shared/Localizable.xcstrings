    "library.item.purgeOriginalHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件留在原位置（原盘目录或没能移入回收站），清理会直接从磁盘删除，此操作不可恢复。若它仍被下载器做种，清理会中断做种任务（PT 站请留意保种要求）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "该文件留在原位置（原盘目录或没能移入回收站），清理会直接从磁盘删除，此操作不可恢复。若它仍被下载器做种，清理会中断做种任务（PT 站请留意保种要求）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This file is still in its original location because it was not moved to the recycle bin. Clearing it deletes it from disk permanently. If your downloader is seeding this file, seeding will stop. Check your tracker's seeding requirements first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Datei liegt noch am ursprünglichen Ort, weil sie nicht in den Papierkorb verschoben wurde. Beim Entfernen wird sie dauerhaft von der Festplatte gelöscht. Seedet dein Downloader diese Datei, endet das Seeding. Prüfe vorher die Seeding-Anforderungen deines Trackers."
          }
        }
      }
    },
    "library.item.purgeTrashHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将立即从回收站删除该文件，不再等待保留期，此操作不可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "将立即从回收站删除该文件，不再等待保留期，此操作不可恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This permanently deletes the file from the recycle bin immediately, without waiting for the retention period."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit wird die Datei sofort dauerhaft aus dem Papierkorb gelöscht, ohne das Ende der Aufbewahrungszeit abzuwarten."
          }
        }
      }
    },
