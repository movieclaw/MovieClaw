    "settings.updateUi.storageHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "占用 %@。减少保留数量会立即清理较早版本。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "占用 %@。减少保留数量会立即清理较早版本。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses %@. Keeping fewer versions removes older ones immediately."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Belegt %@. Wenn du weniger Versionen behältst, werden ältere Versionen sofort entfernt."
          }
        }
      },
      "comment": "Footer."
    },
    "settings.updateUi.restoreHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前数据结构比该版本新（中间经过数据库升级）。回退将恢复 %@ 自动备份的数据，此后产生的数据（订阅活动、入库记录等）将丢失；回退前会再自动备份一次当前数据，切回新版本时可完整还原。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "当前数据结构比该版本新（中间经过数据库升级）。回退将恢复 %@ 自动备份的数据，此后产生的数据（订阅活动、入库记录等）将丢失；回退前会再自动备份一次当前数据，切回新版本时可完整还原。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database structure is newer than this version because of an intervening upgrade. Rolling back restores the automatic backup from %@; later data, such as subscription activity and import records, will be lost. Current data is backed up first, so switching back to the newer version restores it completely."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein zwischenzeitliches Update hat die Datenbankstruktur geändert, sodass sie neuer ist als diese Version. Beim Zurücksetzen wird das automatische Backup von %@ wiederhergestellt. Spätere Daten wie Abo-Aktivitäten und Importprotokolle gehen dabei verloren. Der aktuelle Stand wird vorher gesichert und ist beim erneuten Wechsel zur neueren Version vollständig wiederherstellbar."
          }
        }
      },
      "comment": "Rollback detail."
    },
    "settings.playback.clips.doneSkipped": {
