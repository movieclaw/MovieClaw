    "settings.update.ui.versionTimeoutHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍后手动刷新页面。若反复无法恢复，容器会自动回落到更新前的版本，数据不受影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "请稍后手动刷新页面。若反复无法恢复，容器会自动回落到更新前的版本，数据不受影响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Refresh the page later. If recovery keeps failing, the container automatically returns to the previous version without affecting your data."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade die Seite später neu. Scheitert die Wiederherstellung weiterhin, kehrt der Container automatisch zur vorherigen Version zurück, ohne deine Daten zu beeinträchtigen."
          }
        }
      }
    },
