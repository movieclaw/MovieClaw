        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 小时"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld hr"
          }
        }
      },
      "comment": "Movie runtime in whole hours; parameter: count."
    },
