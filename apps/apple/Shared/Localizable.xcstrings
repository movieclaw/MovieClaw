          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Aufgabe, um ihre Planung zu bearbeiten. Änderungen werden beim Speichern auf dem Server aktiv, ohne Neustart, wirksam."
          }
        }
      }
    },
    "settings.scheduledTasks.nativeNetworkHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有媒体库放在网络挂载上：实时监控收不到远端变化，新文件全靠「媒体库对账」发现。现在是%@，建议调到每 1 小时——增量对账通常只需几秒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有媒体库放在网络挂载上：实时监控收不到远端变化，新文件全靠「媒体库对账」发现。现在是%@，建议调到每 1 小时——增量对账通常只需几秒。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A library uses a network mount. File watching cannot detect remote changes, so Library reconciliation is needed to discover new files. The current schedule is %@. Running every hour is recommended; incremental reconciliation usually takes only a few seconds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Mediathek liegt auf einem eingebundenen Netzlaufwerk. Die Dateiüberwachung kann Änderungen dort nicht erkennen. Plane deshalb regelmäßige Abgleiche ein. Aktuell: %@. Ein stündlicher Abgleich wird empfohlen und dauert meist nur wenige Sekunden."
          }
        }
      }
    },
