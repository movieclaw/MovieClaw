    "subscription.seasonCleanup.taskConsequenceOne": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从下载器移除任务，并删除下载目录里的文件，不可恢复。以后重新勾选这一季需要重新下载。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "从下载器移除任务，并删除下载目录里的文件，不可恢复。以后重新勾选这一季需要重新下载。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tasks and their downloaded files will be permanently removed from the downloader. Selecting this season again will require another download."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aufgaben und die heruntergeladenen Dateien werden vom Downloader dauerhaft entfernt. Eine erneute Auswahl dieser Staffel erfordert einen neuen Download."
          }
        }
      }
    },
