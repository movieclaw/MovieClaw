    "settings.memberDetail.resetHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧密码和网页、App、播放器上的登录会立即失效，已配对的命令行保留。新密码只显示一次。"
          }
        },
