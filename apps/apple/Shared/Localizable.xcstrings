          }
        }
      }
    },
    "settings.devices.labels.androidtvAdmin": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将获得：这台 Android TV 以你的超级管理员身份登录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
