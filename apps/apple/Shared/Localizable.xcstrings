    "subscription.rules.upgradeHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收齐后继续追更高版本，直到达到目标档位为止。新版本入库后旧版本进回收站保留 7 天，做种中的任务不受影响；不开启 = 下到即止"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收齐后继续追更高版本，直到达到目标档位为止。新版本入库后旧版本进回收站保留 7 天，做种中的任务不受影响；不开启 = 下到即止"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep looking for better releases after completion until the target is reached. After import, old versions stay in the recycle bin for 7 days; seeding tasks are unaffected. Disable to stop after downloading."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nach Abschluss weiter nach besseren Releases suchen, bis das Ziel erreicht ist. Nach dem Import bleiben alte Versionen 7 Tage im Papierkorb; Seeding-Aufgaben sind nicht betroffen. Deaktivieren, um nach dem Download aufzuhören."
          }
        }
      }
    },
