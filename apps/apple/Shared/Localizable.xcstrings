    "settings.memberDetail.resetHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "旧密码和网页、App、播放器上的登录会立即失效，已配对的命令行保留。新密码只显示一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "旧密码和网页、App、播放器上的登录会立即失效，已配对的命令行保留。新密码只显示一次。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old password and sign-ins on the web, apps and players stop working immediately; paired command-line tools are kept. The new password is shown only once."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das alte Passwort und die Anmeldungen über Web, Apps und Player funktionieren sofort nicht mehr; die verbundenen Befehlszeilen-Tools bleiben erhalten. Das neue Passwort wird nur einmal angezeigt."
          }
        }
      },
      "comment": "Member details."
    },
    "settings.memberDetail.signOutHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "网页、App、命令行和播放器上的登录都会失效，正在播放的内容也会停止。账号保留，重新登录即可使用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "网页、App、命令行和播放器上的登录都会失效，正在播放的内容也会停止。账号保留，重新登录即可使用。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign-ins on the web, apps, command line and players stop working, and playback stops. The account is kept and can sign in again."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmeldung über das Web, Apps, Befehlszeile und Player wird gestoppt, Playback beendet. Konto bleibt erhalten und kann erneut angemeldet werden."
