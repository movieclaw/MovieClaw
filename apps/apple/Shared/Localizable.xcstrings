    "library.issues.kindMismatchMovieLib": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 个文件的实际类型与本库不符（剧集文件在电影库），认领无法解决。个别文件放错了：把文件移到对应类型的库即可；整库类型建错了：删除本库并以正确类型重建（删库不会动磁盘文件），重新扫描即可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 个文件的实际类型与本库不符（剧集文件在电影库），认领无法解决。个别文件放错了：把文件移到对应类型的库即可；整库类型建错了：删除本库并以正确类型重建（删库不会动磁盘文件），重新扫描即可恢复。"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld file does not match this library’s type (a TV file in a movie library). Assigning an identity cannot fix this. Move misplaced files to a library of the right type; if the whole library has the wrong type, delete it and recreate it with the right type (this does not touch files on disk), then scan again."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld files do not match this library’s type (TV files in a movie library). Assigning an identity cannot fix this. Move misplaced files to a library of the right type; if the whole library has the wrong type, delete it and recreate it with the right type (this does not touch files on disk), then scan again."
                }
              }
            }
          }
        }
      },
      "comment": "Issues hint."
    },
