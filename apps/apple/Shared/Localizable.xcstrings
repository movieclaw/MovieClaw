        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Anfrage abgelehnt (Feld %@%@). Falls deine Eingabe korrekt ist, aktualisiere App und Server auf die neueste Version, dann versuch es erneut (Fehler 422)."
