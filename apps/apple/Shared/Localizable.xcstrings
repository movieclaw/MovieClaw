    "settings.networkUi.restartHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前连接地址可能已失效。Docker bridge 部署需将端口映射的容器侧端口改为 %@ 并重建容器。重启后请在登录页的「更换服务器」中填写新地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "当前连接地址可能已失效。Docker bridge 部署需将端口映射的容器侧端口改为 %@ 并重建容器。重启后请在登录页的「更换服务器」中填写新地址。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The current address may no longer work. With Docker bridge networking, change the container-side port mapping to %@ and recreate the container. After the restart, enter the new address under Change server on the sign-in page."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die aktuelle Adresse funktioniert möglicherweise nicht mehr. Ändere bei Docker mit Bridge-Netzwerk die Zuordnung des Container-Ports auf %@ und erstelle den Container neu. Gib nach dem Neustart auf der Anmeldeseite unter „Server wechseln“ die neue Adresse ein."
          }
        }
      },
      "comment": "Restart notice."
    },
    "settings.networkUi.portFallback": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
