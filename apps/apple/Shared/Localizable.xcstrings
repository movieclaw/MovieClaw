    "settings.devices.labels.tvBody": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等同你在这台电视上输入账号密码登录：它能看到你能看到的媒体库、记录你的观看进度。只批准你面前这台电视上显示的配对码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等同你在这台电视上输入账号密码登录：它能看到你能看到的媒体库、记录你的观看进度。只批准你面前这台电视上显示的配对码。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is equivalent to entering your username and password on this TV: it can access the same media libraries and record your viewing progress. Only approve the pairing code shown on the TV in front of you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das entspricht der Eingabe von Benutzername und Passwort auf diesem Fernseher: Er kann auf dieselben Mediatheken zugreifen und deinen Wiedergabefortschritt speichern. Bestätige nur den Kopplungscode, der auf dem Fernseher vor dir angezeigt wird."
          }
        }
      }
    },
