    },
    "library.transfer.directoryTail": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（视频、NFO、海报、字幕）会连同库存记录一起搬到目标库；目录名原样保留，需要规范化请到目标库运行「整理文件名」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "（视频、NFO、海报、字幕）会连同库存记录一起搬到目标库；目录名原样保留，需要规范化请到目标库运行「整理文件名」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " (videos, NFO, posters and subtitles) moves to the target library together with its inventory records. The directory name is kept; run Organize file names in the target library to normalize it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " (Videos, NFO-Dateien, Poster und Untertitel) wird mit den zugehörigen Einträgen in die Zielmediathek verschoben. Der Ordnername bleibt erhalten. Mit „Dateinamen organisieren“ in der Zielmediathek kannst du ihn vereinheitlichen."
          }
        }
      },
      "comment": "After the emphasized phrase."
    },
    "library.transfer.noTargetLibrary": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有其他%@库可选——请先在「媒体库」页新建一个，再回来转移。"
          }
        },
        "zh-Hant": {
