    "auth.accounts.removeCurrentDeviceHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是当前账号。退出后本机不再保留它的登录状态，会自动切到其他账号；再回来需要重新输入密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "这是当前账号。退出后本机不再保留它的登录状态，会自动切到其他账号；再回来需要重新输入密码。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the current account. Signing out removes it from this device and switches to another account; you will need its password to return."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist das aktuelle Konto. Durch die Abmeldung wird es von diesem Gerät entfernt und MovieClaw wechselt zu einem anderen Konto. Um dich wieder anzumelden, brauchst du das Passwort."
          }
        }
      }
    },
