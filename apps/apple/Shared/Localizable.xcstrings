    "settings.macInstall.fromDiskImage": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你现在是直接在安装盘里打开的。请退出后回到安装盘窗口，把 MovieClaw 拖到右边的「应用程序」文件夹，再从「应用程序」或启动台打开。装进去之后才能正常使用，以后也能自动更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你现在是直接在安装盘里打开的。请退出后回到安装盘窗口，把 MovieClaw 拖到右边的「应用程序」文件夹，再从「应用程序」或启动台打开。装进去之后才能正常使用，以后也能自动更新。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You opened MovieClaw directly from the disk image. Quit, return to the disk image window, drag MovieClaw to the Applications folder on the right, then open it from Applications or Launchpad. MovieClaw works properly and updates automatically only after it’s installed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast MovieClaw direkt aus dem Disk-Image geöffnet. Beende MovieClaw und kehre zum Fenster des Disk-Images zurück. Ziehe MovieClaw rechts in den Ordner „Programme“ und öffne es dann aus „Programme“ oder Launchpad. Erst nach der Installation funktioniert MovieClaw richtig und aktualisiert sich automatisch."
          }
        }
      }
    },
    "settings.macInstall.elsewhere": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你现在是在「应用程序」以外的地方打开的（比如「下载」）。请退出后在访达里把它拖进「应用程序」文件夹，再从那里打开。装进去之后才能正常使用，以后也能自动更新。它现在在："
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你现在是在「应用程序」以外的地方打开的（比如「下载」）。请退出后在访达里把它拖进「应用程序」文件夹，再从那里打开。装进去之后才能正常使用，以后也能自动更新。它现在在："
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You opened MovieClaw from outside Applications (for example, Downloads). Quit, drag it into the Applications folder in Finder, then open it from there. MovieClaw works properly and updates automatically only after it’s installed. It’s currently in:"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du hast MovieClaw außerhalb des Ordners „Programme“ geöffnet, etwa aus „Downloads“. Beende MovieClaw, ziehe es im Finder in den Ordner „Programme“ und öffne es von dort. Erst nach der Installation funktioniert MovieClaw richtig und aktualisiert sich automatisch. Der aktuelle Speicherort ist:"
          }
        }
      }
    },
