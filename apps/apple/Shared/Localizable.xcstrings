    "settings.about.tvPrivacySummary": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MovieClaw 是自托管服务的客户端：你的媒体、账号与观看记录都在你自己部署的服务器上，App 不向开发者或任何第三方上传数据。项目主页：github.com/movieclaw/movieclaw"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MovieClaw 是自托管服务的客户端：你的媒体、账号与观看记录都在你自己部署的服务器上，App 不向开发者或任何第三方上传数据。项目主页：github.com/movieclaw/movieclaw"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MovieClaw is a client for your self-hosted server. Your media, accounts and watch history stay on the server you deploy. The app does not upload data to the developer or any third party. Project: github.com/movieclaw/movieclaw"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MovieClaw ist ein Client für deinen selbst gehosteten Server. Medien, Konten und Wiedergabeverlauf bleiben auf deinem Server. Die App überträgt keine Daten an den Entwickler oder an Dritte. Projekt: github.com/movieclaw/movieclaw"
          }
        }
      }
    },
    "settings.about.components": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开源组件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "开源组件"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open-source components"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Open-Source-Komponenten"
          }
        }
      }
    },
    "settings.about.componentsDescription": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "播放引擎 AetherEngine 与 FFmpeg 以动态框架随 App 分发，你可以按各自的许可获取源码、修改并替换。本 App 使用的 AetherEngine 修改版源码可通过下方组件链接获取，链接对应本次构建使用的提交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "播放引擎 AetherEngine 与 FFmpeg 以动态框架随 App 分发，你可以按各自的许可获取源码、修改并替换。本 App 使用的 AetherEngine 修改版源码可通过下方组件链接获取，链接对应本次构建使用的提交。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The AetherEngine playback engine and FFmpeg are distributed with the app as dynamic frameworks. Their licenses allow you to obtain, modify and replace their source code. The component links below include the modified AetherEngine source used by this app and point to the commit used for this build."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Wiedergabe-Engine AetherEngine und FFmpeg werden als dynamische Frameworks mitgeliefert. Die jeweiligen Lizenzen erlauben dir, den Quellcode zu beziehen, zu ändern und zu ersetzen. Die Komponenten-Links unten führen zum angepassten Quellcode von AetherEngine und zum Commit, der für diese Version verwendet wurde."
          }
        }
      }
    },
    "settings.about.tmdbAttribution": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影视资料与图片由你的服务器从 TMDB（themoviedb.org）等来源获取。本产品使用 TMDB API，但未经 TMDB 认可或认证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影视资料与图片由你的服务器从 TMDB（themoviedb.org）等来源获取。本产品使用 TMDB API，但未经 TMDB 认可或认证。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server obtains film and TV information and images from sources including TMDB (themoviedb.org). This product uses the TMDB API but is not endorsed or certified by TMDB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server bezieht Informationen und Bilder zu Filmen und Serien unter anderem von TMDB (themoviedb.org). Dieses Produkt nutzt die TMDB-API. TMDB empfiehlt und zertifiziert es nicht."
          }
        }
      }
    },
