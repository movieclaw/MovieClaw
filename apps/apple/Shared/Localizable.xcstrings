    "library.form.networkWatchHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到根路径在网络挂载（NFS/SMB）上：这里收不到远端的变化通知，开着也不会建监听。新文件由定期对账发现（可在「设置 → 应用 → 定时任务」调周期，增量对账通常只需几秒）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到根路径在网络挂载（NFS/SMB）上：这里收不到远端的变化通知，开着也不会建监听。新文件由定期对账发现（可在「设置 → 应用 → 定时任务」调周期，增量对账通常只需几秒）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The root is on a network mount (NFS/SMB), which does not deliver remote change notifications. No watcher is created even when this is on. Scheduled reconciliation finds new files; change its interval in Settings → Application → Scheduled tasks. Incremental checks usually take seconds."
          }
        }
      }
    },
    "library.form.watchHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新文件落盘后自动增量扫描入库。SMB/NFS 等网络挂载收不到远端变化通知、建立监听还很慢，建议关闭；关闭后由定期对账和手动扫描发现新文件，不实时但不会缺失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新文件落盘后自动增量扫描入库。SMB/NFS 等网络挂载收不到远端变化通知、建立监听还很慢，建议关闭；关闭后由定期对账和手动扫描发现新文件，不实时但不会缺失。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically scan and add new files when they arrive. SMB/NFS mounts do not deliver remote change notifications and take time to set up watchers, so monitoring should be turned off for them. Scheduled checks and manual scans still find every new file, with a delay."
          }
        }
      }
    },
