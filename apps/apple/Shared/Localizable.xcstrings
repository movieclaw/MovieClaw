    "library.reidentify.networkProblem": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有文件因为 TMDB 不可达没能得出结论——那是网络问题不是识别问题。建议先修好网络再来，此刻的结论不足以据此拍板。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有文件因为 TMDB 不可达没能得出结论——那是网络问题不是识别问题。建议先修好网络再来，此刻的结论不足以据此拍板。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some files could not be identified because TMDB was unreachable. That is a network problem, not an identification problem; fix the network first, as the current result is not reliable enough to decide on."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einige Dateien konnten nicht zugeordnet werden, weil TMDB nicht erreichbar war. Behebe zuerst das Netzwerkproblem, da das aktuelle Ergebnis für eine Entscheidung noch zu unzuverlässig ist."
          }
        }
      },
      "comment": "Warning."
    },
