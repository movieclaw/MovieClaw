    "library.collections.reorderHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动调整先后；顺序在网页、播放器和分享页三处一致。移出去只是从名单里去掉，影片一部都不会少。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动调整先后；顺序在网页、播放器和分享页三处一致。移出去只是从名单里去掉，影片一部都不会少。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to reorder. The web app, players and share page use the same order. Removing a title from this list keeps it in your library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen, um die Reihenfolge zu ändern. Die Web-App, die Player und die Teilen-Seite verwenden die gleiche Reihenfolge. Ein Titel, der aus dieser Liste entfernt wird, bleibt in deiner Mediathek."
          }
        }
      },
      "comment": "Manual collection hint."
    },
    "library.issues.kindMismatchMovieLib": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 个文件的实际类型与本库不符（剧集文件在电影库），认领无法解决。个别文件放错了：把文件移到对应类型的库即可；整库类型建错了：删除本库并以正确类型重建（删库不会动磁盘文件），重新扫描即可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %lld 个文件的实际类型与本库不符（剧集文件在电影库），认领无法解决。个别文件放错了：把文件移到对应类型的库即可；整库类型建错了：删除本库并以正确类型重建（删库不会动磁盘文件），重新扫描即可恢复。"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld file does not match this library’s type (a TV file in a movie library). Assigning an identity cannot fix this. Move misplaced files to a library of the right type; if the whole library has the wrong type, delete it and recreate it with the right type (this does not touch files on disk), then scan again."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld files do not match this library’s type (TV files in a movie library). Assigning an identity cannot fix this. Move misplaced files to a library of the right type; if the whole library has the wrong type, delete it and recreate it with the right type (this does not touch files on disk), then scan again."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Datei passt nicht zum Typ dieser Mediathek: Es ist eine Serienfolge in einer Filmmediathek. Eine neue Titelzuordnung löst das nicht. Verschiebe falsch einsortierte Dateien in eine passende Mediathek. Hat die ganze Mediathek den falschen Typ, lösche sie, lege sie mit dem richtigen Typ neu an und scanne erneut. Dabei bleiben die Dateien auf dem Laufwerk erhalten."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld Dateien passen nicht zum Typ dieser Mediathek: Es sind Serienfolgen in einer Filmmediathek. Eine neue Titelzuordnung löst das nicht. Verschiebe falsch einsortierte Dateien in eine passende Mediathek. Hat die ganze Mediathek den falschen Typ, lösche sie, lege sie mit dem richtigen Typ neu an und scanne erneut. Dabei bleiben die Dateien auf dem Laufwerk erhalten."
                }
              }
            }
          }
        }
      },
      "comment": "Issues hint."
    },
