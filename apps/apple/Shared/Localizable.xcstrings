    "subscription.rules.scopeHintText": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅的作品符合这里的条件时，自动选用本规则组；多个组都符合时条件更多的优先，都不符合时用默认组。只选「电影」或「剧集」即可让本组成为该类型的默认选择。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "订阅的作品符合这里的条件时，自动选用本规则组；多个组都符合时条件更多的优先，都不符合时用默认组。只选「电影」或「剧集」即可让本组成为该类型的默认选择。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This rule set is selected automatically for matching titles. More conditions take priority; otherwise the default is used. Select only Movie or Series to make this the default for that type."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Regelgruppe wird für passende Titel automatisch gewählt. Mehr Bedingungen haben Vorrang; sonst gilt die Standardgruppe. Wähle nur „Film“ oder „Serie“, um sie zum Standard für diesen Typ zu machen."
          }
        }
      }
    },
    "subscription.rules.priorityHintText": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按顺序逐维度比较，先分出高低的那一维说了算。每多一维，就多一轮潜在的重复下载——缺省只比分辨率与片源。标「未配置」的维度会被自动跳过；全被跳过时按缺省的「分辨率 › 片源」比。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按顺序逐维度比较，先分出高低的那一维说了算。每多一维，就多一轮潜在的重复下载——缺省只比分辨率与片源。标「未配置」的维度会被自动跳过；全被跳过时按缺省的「分辨率 › 片源」比。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare dimensions in order; the first difference decides. Each extra dimension may mean another download. By default, only resolution and source are compared. Dimensions marked Not configured are skipped; if all are skipped, resolution › source is used."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kriterien werden der Reihe nach verglichen. Der erste Unterschied entscheidet. Jedes weitere Kriterium kann einen zusätzlichen Download auslösen. Standardmäßig zählen nur Auflösung und Quelle. Als „Nicht konfiguriert“ markierte Kriterien werden übersprungen. Wenn alle übersprungen werden, gilt Auflösung › Quelle."
          }
        }
      }
    },
    "subscription.rules.platformOrderWarning": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "很多资源的标题里根本没写平台。把平台排在前面，等于要求「先比平台再比别的」——没写平台的资源就全都分不出高低，洗版会大面积停住。建议把平台放到最后一位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "很多资源的标题里根本没写平台。把平台排在前面，等于要求「先比平台再比别的」——没写平台的资源就全都分不出高低，洗版会大面积停住。建议把平台放到最后一位。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Many release titles omit the platform. Comparing platform first can prevent upgrades because those releases cannot be ranked. Put platform last."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Viele Release-Titel nennen keine Plattform. Wird die Plattform zuerst verglichen, kann das Upgrades verhindern, weil sich diese Releases nicht einordnen lassen. Setze die Plattform an letzte Stelle."
          }
        }
      }
    },
