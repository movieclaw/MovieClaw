    "library.transfer.fileTail": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（连同同名的 NFO、字幕）会连同库存记录一起搬到目标库；文件在库里的所在目录结构原样保留，同目录下别的条目留在原地不动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "（连同同名的 NFO、字幕）会连同库存记录一起搬到目标库；文件在库里的所在目录结构原样保留，同目录下别的条目留在原地不动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": ", with its matching NFO and subtitle files, moves to the target library together with its inventory records. Its directory structure is kept, and other titles in the same directory stay where they are."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": ", die zugehörige NFO-Datei, Untertitel und Bestandseinträge werden in die Zielmediathek verschoben. Die Ordnerstruktur bleibt erhalten. Andere Titel im selben Ordner bleiben an ihrem Platz."
          }
        }
      },
      "comment": "After the emphasized phrase."
    },
    "library.transfer.directoryLead": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分错库时用它补救（例如韩剧被判进了「大陆华语剧」）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "分错库时用它补救（例如韩剧被判进了「大陆华语剧」）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use this to correct the library assignment (for example, a Korean series filed under Chinese series). "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit korrigierst du die Zuordnung zur Mediathek, etwa wenn eine koreanische Serie bei den chinesischen Serien liegt. "
          }
        }
      },
      "comment": "Before the emphasized phrase."
    },
    "library.transfer.directoryEmphasis": {
      "extractionState": "manual",
