    "activity.jobs.dismissExplanation": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会从「需要处理」下架，移到「已结束」。任务记录、失败原因和重试入口都还在，随时可以撤销忽略。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它会从「需要处理」下架，移到「已结束」。任务记录、失败原因和重试入口都还在，随时可以撤销忽略。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It will move from Needs attention to Finished. The task record, failure reason and retry action remain available. You can undo dismissal at any time."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie wandert von „Erfordert Aufmerksamkeit“ nach „Abgeschlossen“. Der Aufgabeneintrag, der Fehlergrund und die Möglichkeit zum erneuten Ausführen bleiben erhalten. Du kannst das Ausblenden jederzeit rückgängig machen."
          }
        }
      },
      "comment": "Dismiss task dialog body."
    },
    "activity.jobs.muteExplanation": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不勾选的话，下次扫描媒体库时系统还会自动重新生成一次、再失败一次。手动生成不受影响，你随时可以自己再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不勾选的话，下次扫描媒体库时系统还会自动重新生成一次、再失败一次。手动生成不受影响，你随时可以自己再试。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without this option, the next library scan will automatically try generation again and may fail again. Manual generation remains available whenever you want to try."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne diese Option versucht der nächste Mediathek-Scan die Erzeugung automatisch erneut – und scheitert womöglich wieder. Manuell erzeugen kannst du jederzeit."
          }
        }
      },
      "comment": "Dismiss dialog: mute automatic subtitles."
    },
