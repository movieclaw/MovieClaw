        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "申请权限：官方推送。关闭网页不会取消配对，批准后会自动完成连接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requested permission: official push. Closing the web page does not cancel pairing; the connection completes automatically once approved."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermächtigung angefordert: offizieller Push. Das Schließen der Webseite hebt die Paarung nicht auf; die Verbindung wird automatisch abgeschlossen, sobald die Genehmigung erteilt wurde."
          }
        }
      },
      "comment": "MovieClaw Cloud settings."
    },
