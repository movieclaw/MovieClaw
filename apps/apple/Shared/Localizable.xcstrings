        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按规则整理到该目录后不写库台账，文件出现在库根时由扫描收尾"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files are organized into that directory without adding library records. Library scans record them when they appear under a library root."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien werden in dieses Verzeichnis einsortiert, ohne Einträge in der Mediathek anzulegen. Mediathek-Scans erfassen sie, sobald sie unter einem Stammpfad einer Mediathek auftauchen."
          }
        }
      }
    },
