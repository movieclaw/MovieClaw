    "library.form.movie.blurb": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动识别影片，补齐简介、评分、演职员与海报剧照；一部片一个目录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自动识别影片，补齐简介、评分、演职员与海报剧照；一部片一个目录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identify movies and fetch descriptions, ratings, cast, crew, posters and backdrops. Each movie has its own folder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Filme identifizieren und Beschreibungen, Bewertungen, Besetzung, Team, Poster und Hintergrundbilder abrufen. Jeder Film hat einen eigenen Ordner."
          }
        }
      }
    },
    "library.form.tv.blurb": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动识别剧集与季集，补齐分集信息与图片；追新订阅按集补齐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自动识别剧集与季集，补齐分集信息与图片；追新订阅按集补齐。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Identify series, seasons and episodes, fetch episode details and images, and keep subscriptions up to date episode by episode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Serien, Staffeln und Folgen identifizieren, Folgendetails und Bilder abrufen und Abos Folge für Folge aktuell halten."
          }
        }
      }
    },
    "library.form.video.blurb": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不识别、不刮削、不改名的视频：放什么由你定。有 NFO 就读 NFO，否则按文件名展示，封面从视频里抓帧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不识别、不刮削、不改名的视频：放什么由你定。有 NFO 就读 NFO，否则按文件名展示，封面从视频里抓帧。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos you organize yourself, without identification, metadata lookup or renaming. Read an NFO if present; otherwise use the file name. Covers come from video frames."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Videos, die du selbst organisierst – ohne Identifizierung, Metadatensuche oder Umbenennen. Eine vorhandene NFO wird gelesen, sonst der Dateiname verwendet. Cover stammen aus Videoframes."
          }
        }
      }
    },
    "library.form.photo.blurb": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不识别、不刮削，扫描目录里的所有图片，按拍摄时间排成相册墙；点开全屏查看。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "不识别、不刮削，扫描目录里的所有图片，按拍摄时间排成相册墙；点开全屏查看。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan images in the folders and arrange them by capture time in an album wall. Open an image full screen. No identification or metadata lookup."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder in den Ordnern scannen und nach Aufnahmezeit als Album-Wand anordnen. Ein Bild lässt sich im Vollbild öffnen. Keine Identifizierung oder Metadatensuche."
          }
        }
      }
    },
