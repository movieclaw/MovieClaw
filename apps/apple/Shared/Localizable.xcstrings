    "agent.consent.destination": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你发出的消息和图片，以及助手为了回答而查询的媒体库信息，会由你的 MovieClaw 服务器发送给服务器管理员接入的 AI 模型服务商处理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你发出的消息和图片，以及助手为了回答而查询的媒体库信息，会由你的 MovieClaw 服务器发送给服务器管理员接入的 AI 模型服务商处理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your messages and images, and the library information the assistant looks up to answer, are sent by your MovieClaw server to the AI model provider your administrator connected."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein MovieClaw-Server sendet deine Nachrichten und Bilder sowie die Infos, die der Assistent für seine Antwort in der Mediathek nachschlägt, an den von deinem Administrator verbundenen KI-Modellanbieter."
          }
        }
      }
    },
