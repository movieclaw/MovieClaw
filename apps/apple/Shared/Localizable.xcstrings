    "subscription.adjust.descriptionText": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "《%@》——加季会恢复或补建追踪；减季会让整季退出追踪范围，但不会删除下载器任务、已下载文件或入库内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "《%@》——加季会恢复或补建追踪；减季会让整季退出追踪范围，但不会删除下载器任务、已下载文件或入库内容。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%@” — Adding seasons restores or creates tracking. Removing a season stops tracking it, while downloader tasks, downloaded files and library content are kept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%@“ — Wenn du Staffeln hinzufügst, werden sie verfolgt oder erneut aufgenommen. Entfernst du eine Staffel, wird sie nicht mehr verfolgt. Aufgaben im Downloader, Downloads und Mediathekinhalte bleiben erhalten."
          }
        }
      }
    },
    "subscription.adjust.droppedProgressOne": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %@ 季已有下载进度：保存只让它退出追踪（停止进度关联、缺失搜索与自动换源），不会动任何文件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "第 %@ 季已有下载进度：保存只让它退出追踪（停止进度关联、缺失搜索与自动换源），不会动任何文件"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Season %@ already has download progress. Saving stops progress linking, missing-release searches and automatic source replacement. Files are kept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Staffel %@ hat bereits Download-Progress. Der Speicher beendet die Verknüpfung des Fortschritts, die Suche nach fehlenden Releases und die automatische Quellenersetzung. Die Dateien werden beibehalten."
          }
        }
      }
    },
