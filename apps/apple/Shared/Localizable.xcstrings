    "settings.llm.ui.emptyIntro": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入一个或多个大语言模型供应商，AI 能力（对话助手、字幕处理、智能识别等）将由它们驱动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接入一个或多个大语言模型供应商，AI 能力（对话助手、字幕处理、智能识别等）将由它们驱动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Connect one or more large language model providers to power conversations, subtitles, smart identification and other AI features."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbinde einen oder mehrere Anbieter großer Sprachmodelle für Unterhaltungen, Untertitel, intelligente Identifizierung und weitere KI-Funktionen."
          }
        }
      }
    },
    "settings.llm.ui.connectedIntro": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入后该供应商目录里的全部模型都可在对话框里选用；各场景默认用哪个模型，在「AI 设定」里配置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "接入后该供应商目录里的全部模型都可在对话框里选用；各场景默认用哪个模型，在「AI 设定」里配置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All models in a connected provider’s catalog are available in conversations. Choose the default model for each use in AI preferences."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Modelle im Katalog eines verbundenen Anbieters stehen in Unterhaltungen zur Verfügung. Das Standardmodell für jeden Einsatzzweck wählst du unter „KI-Einstellungen“."
          }
        }
      }
    },
