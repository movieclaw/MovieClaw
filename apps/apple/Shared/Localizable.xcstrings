          }
        }
      }
    },
    "subscription.rules.platform": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "流媒体平台"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "流媒体平台"
          }
        },
        "en": {
