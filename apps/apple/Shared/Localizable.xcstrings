    "subscription.overview.discoverAllHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去发现页挑选一部剧集或电影，打开详情并点击「订阅追踪」，有合适资源时会自动下载入库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "去发现页挑选一部剧集或电影，打开详情并点击「订阅追踪」，有合适资源时会自动下载入库。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a series or movie in Discover, open its details and select Subscribe. Suitable releases will download and import automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle unter „Entdecken“ eine Serie oder einen Film, öffne die Details und wähle „Abonnieren“. Passende Releases werden automatisch heruntergeladen und importiert."
          }
        }
      }
    },
