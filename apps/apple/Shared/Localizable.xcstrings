      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只接受这些制作组的资源，逗号或空格分隔（如 FRDS, WiKi）；留空 = 不限"
          }
        },
        "zh-Hant": {
