    "agent.consent.privacy": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MovieClaw 的开发者不会收到这些内容。服务商如何处理数据以其隐私政策为准；服务器管理员可以在「设置 → 模型接入」更换或移除服务商。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MovieClaw 的开发者不会收到这些内容。服务商如何处理数据以其隐私政策为准；服务器管理员可以在「设置 → 模型接入」更换或移除服务商。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MovieClaw’s developers never receive this content. The provider’s privacy policy governs how it handles data; your server administrator can change or remove providers in Settings → Models."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Entwickler von MovieClaw erhalten diese Inhalte nie. Für den Umgang mit den Daten gilt die Datenschutzerklärung des Anbieters. Dein Serveradministrator kann unter „Einstellungen → Modelle“ Anbieter wechseln oder entfernen."
          }
        }
      }
    },
