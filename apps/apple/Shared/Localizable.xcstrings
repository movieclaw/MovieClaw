    "settings.update.ui.appTimeoutHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 部署通常几秒内自动拉起，请稍后手动刷新页面；源码部署且无 systemd 等守护时，需要到服务器上手动启动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker 部署通常几秒内自动拉起，请稍后手动刷新页面；源码部署且无 systemd 等守护时，需要到服务器上手动启动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker deployments usually restart within seconds. Refresh the page later. Source deployments without a supervisor such as systemd must be started manually on the server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Docker-Installationen starten meist innerhalb von Sekunden neu. Lade die Seite später neu. Installationen aus dem Quellcode ohne Supervisor wie systemd müssen manuell auf dem Server gestartet werden."
          }
        }
      }
    },
