    "library.form.scopeTail": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "：作为默认库承接所有未命中的作品；订阅时永远可以手动改库。"
