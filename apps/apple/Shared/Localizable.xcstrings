    "settings.mcpUi.connectHelpText": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "令牌明文只在创建和轮换时显示一次（服务端只存哈希），忘了可在右上角操作菜单轮换。传输是 Streamable HTTP，客户端里选「HTTP」而不是 SSE；claude.ai 网页版的自定义连接器只支持 OAuth，暂时接不进来，Claude Code、Cursor、Cline 等本地客户端都可以。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "令牌明文只在创建和轮换时显示一次（服务端只存哈希），忘了可在右上角操作菜单轮换。传输是 Streamable HTTP，客户端里选「HTTP」而不是 SSE；claude.ai 网页版的自定义连接器只支持 OAuth，暂时接不进来，Claude Code、Cursor、Cline 等本地客户端都可以。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The token is shown only when created or rotated (the server stores a hash); rotate it from the actions menu if you lose it. The transport is Streamable HTTP, so choose HTTP rather than SSE in your client. Custom connectors on claude.ai only support OAuth and cannot connect yet; local clients such as Claude Code, Cursor and Cline work."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Token wird nur beim Erstellen oder Ersetzen angezeigt. Der Server speichert einen Hash. Wenn du das Token verlierst, ersetze es über das Aktionsmenü. Die Verbindung nutzt Streamable HTTP. Wähle daher im Client HTTP statt SSE. Benutzerdefinierte Konnektoren auf claude.ai unterstützen nur OAuth und können sich noch nicht verbinden. Lokale Clients wie Claude Code, Cursor und Cline funktionieren."
          }
        }
      },
      "comment": "MCP endpoint settings."
    },
    "settings.mcpUi.toolDefinitions": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
