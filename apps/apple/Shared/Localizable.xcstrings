    "library.organize.runningHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每改名一个文件即同步台账，中断也不会账实不符；期间扫描自动让路。\n关闭窗口不影响整理，库卡片上可继续查看进度。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每改名一个文件即同步台账，中断也不会账实不符；期间扫描自动让路。\n关闭窗口不影响整理，库卡片上可继续查看进度。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records update after each file is renamed, so interruptions keep records consistent. Scans wait while organization runs.\nClosing this window does not stop organization; progress stays visible on the library card."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einträge werden nach jeder umbenannten Datei aktualisiert. So bleiben sie bei einer Unterbrechung konsistent. Scans warten, bis das Organisieren abgeschlossen ist.\nDer Vorgang läuft weiter, wenn du dieses Fenster schließt. Den Fortschritt siehst du auf der Mediathekskarte."
          }
        }
      },
      "comment": "Progress hint."
    },
