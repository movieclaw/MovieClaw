    "library.form.scopeLead": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "声明「本库收什么」，订阅与自动入库就会按作品的区域和类型自动选进这个库。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "声明「本库收什么」，订阅与自动入库就会按作品的区域和类型自动选进这个库。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose what this library collects. Subscriptions and automatic imports select it based on a title’s region and genre. "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege fest, was diese Mediathek aufnehmen soll. Abos und automatische Importe wählen sie anhand von Region und Genre eines Titels. "
          }
        }
      },
      "comment": "Before the emphasized phrase."
    },
