    "auth.setup.intro": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一台全新的服务器。将用下面的账号创建超级管理员——它是本站唯一的管理身份，此流程仅在首次部署时出现。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "这是一台全新的服务器。将用下面的账号创建超级管理员——它是本站唯一的管理身份，此流程仅在首次部署时出现。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a new server. The account below will become its super administrator. This setup runs only once, when the server is first deployed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist ein neuer Server. Das unten angelegte Konto erhält die höchsten Administratorrechte. Diese Einrichtung läuft nur einmal beim ersten Start des Servers."
          }
        }
      }
    },
    "auth.pairing.macHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用手机相机或 iPhone 上 MovieClaw 的扫码扫一下，在手机上批准；也可以在 iPhone「设置 → 设备」或已登录的浏览器里输入配对码。谁批准，这台 Mac 就登录成谁。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "用手机相机或 iPhone 上 MovieClaw 的扫码扫一下，在手机上批准；也可以在 iPhone「设置 → 设备」或已登录的浏览器里输入配对码。谁批准，这台 Mac 就登录成谁。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan with your phone camera or the scanner in the iPhone app, then approve on your phone. You can also enter the pairing code in Settings > Devices on iPhone or in a signed-in browser. This Mac signs in as the account that approves it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanne den Code mit der Kamera deines Smartphones oder mit dem Scanner in der iPhone-App. Bestätige die Anfrage auf deinem Smartphone. Du kannst den Kopplungscode auch unter „Einstellungen > Geräte“ auf dem iPhone oder in einem Browser eingeben, in dem du angemeldet bist. Auf diesem Mac wird das Konto angemeldet, das die Anfrage bestätigt."
          }
        }
      }
    },
    "auth.login.credentialsHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入这台服务器上的账号与密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "输入这台服务器上的账号与密码。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your username and password for this server."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gib deinen Benutzernamen und dein Passwort für diesen Server ein."
          }
        }
      }
    },
    "auth.accounts.addMacHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "登录这台或另一台服务器上的账号。\n原来的账号仍留在这台 Mac 上，随时切回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "登录这台或另一台服务器上的账号。\n原来的账号仍留在这台 Mac 上，随时切回。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sign in to an account on this or another server.\nYour previous account stays on this Mac so you can switch back anytime."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich mit einem Konto auf diesem oder einem anderen Server an.\nDein bisheriges Konto bleibt auf diesem Mac, damit du jederzeit zurückwechseln kannst."
          }
        }
      }
    },
