          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的 HTTPS 证书不受信任（常见于自签名证书）：请换用正规证书（如 Let's Encrypt），或改用 http 地址"
          }
        },
