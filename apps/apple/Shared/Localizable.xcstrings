    "settings.networkUi.mirrorHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空使用默认地址。只填域名时会自动补全接口 /3 和图床 /t/p 路径。镜像可作为代理的替代方案；同时配置时会经代理访问镜像。公共镜像会接触你的 API Key，请选可信服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空使用默认地址。只填域名时会自动补全接口 /3 和图床 /t/p 路径。镜像可作为代理的替代方案；同时配置时会经代理访问镜像。公共镜像会接触你的 API Key，请选可信服务。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave blank for the defaults. A bare domain gets the /3 API path and /t/p image path added. Mirrors can replace a proxy; when both are set, mirrors are reached through the proxy. Public mirrors see your API key, so use services you trust."
          }
        }
      },
      "comment": "Network settings."
    },
