    },
    "library.form.selectedHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有选中的人能浏览这个库的内容；其他人在首页、搜索、最近观看和播放器里都看不到它。你始终可以管理它。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只有选中的人能浏览这个库的内容；其他人在首页、搜索、最近观看和播放器里都看不到它。你始终可以管理它。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only selected people can browse this library. Others will not see it on the home page, in search, in recent viewing or in players. You can always manage it."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ausgewählte Personen können diese Mediathek durchstöbern. Andere sehen sie weder auf der Startseite noch in der Suche, unter „Zuletzt geschaut“ oder in Playern. Verwalten kannst du sie immer."
          }
        }
      }
    },
