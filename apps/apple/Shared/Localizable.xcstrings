    "settings.scrape.posterHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "海报和文本一样有语言：中文版、原版、无文字干净版是不同的候选图。你在条目详情页手动选定的图始终优先，不受这里影响。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "海报和文本一样有语言：中文版、原版、无文字干净版是不同的候选图。你在条目详情页手动选定的图始终优先，不受这里影响。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Posters have languages too: Chinese, original and textless artwork are separate candidates. Images you select manually on a title always take priority."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auch Poster haben Sprachen: Chinesische, originale und textlose Bilder sind getrennte Kandidaten. Bilder, die du bei einem Titel manuell auswählst, haben immer Vorrang."
          }
        }
      }
    },
    "settings.scrape.namingHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整理与入库的目录/文件命名。留空即使用默认模板；字段缺失时会连同相邻括号自动收缩。目录层级固定为「条目目录 / 季目录 / 文件」，不可自定义。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "整理与入库的目录/文件命名。留空即使用默认模板；字段缺失时会连同相邻括号自动收缩。目录层级固定为「条目目录 / 季目录 / 文件」，不可自定义。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Directory and file names used when organizing and importing. Leave blank for the default template. Missing fields and their adjacent brackets collapse automatically. The fixed structure is entry directory / season directory / file."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verzeichnis- und Dateinamen, die beim Organisieren und Importieren verwendet werden. Leer lassen für die Standardvorlage. Fehlende Felder samt angrenzender Klammern entfallen automatisch. Die feste Struktur ist Titelverzeichnis / Staffelverzeichnis / Datei."
          }
        }
      }
    },
