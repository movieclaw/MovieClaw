          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Requires a MovieClaw account (only for you, not your family). Notifications are encrypted on this server; neither the cloud nor relays can read them."
          }
        },
        "de": {
          "stringUnit": {
