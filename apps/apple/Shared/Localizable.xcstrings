    "settings.devices.labels.manualFullBody": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持有这枚令牌的程序将能做你在网页上能做的一切，包括删除媒体文件。令牌不会自动过期，只能在这里注销——只把它放进你自己掌握的机器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "持有这枚令牌的程序将能做你在网页上能做的一切，包括删除媒体文件。令牌不会自动过期，只能在这里注销——只把它放进你自己掌握的机器。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program holding this token can do everything you can do on the website, including deleting media files. The token does not expire automatically and can only be revoked here. Store it only on machines you control."
          }
        }
      }
    },
