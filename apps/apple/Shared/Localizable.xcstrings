    "activity.boost.offPageHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭刷流不会删除已有种子：它们会继续满速做种，引擎也不再自动汰换。可点右上角「清理」删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭刷流不会删除已有种子：它们会继续满速做种，引擎也不再自动汰换。可点右上角「清理」删除。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turning boosting off keeps existing torrents seeding at full speed and stops automatic replacement. Use Clean up at the top right to remove them."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wird das Boosting ausgeschaltet, seeden bestehende Torrents mit voller Geschwindigkeit weiter, und der automatische Austausch stoppt. Über „Aufräumen“ oben rechts entfernst du sie."
          }
        }
      }
    },
