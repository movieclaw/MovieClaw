            "value": "Streaming platform"
          }
        }
      }
    },
    "subscription.rules.platformHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下 = 只要，再点 = 排除，第三下取消。设了「只要」之后，识别不出平台的资源会被排除（与分辨率/编码口径一致）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下 = 只要，再点 = 排除，第三下取消。设了「只要」之后，识别不出平台的资源会被排除（与分辨率/编码口径一致）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to require, tap again to exclude, and a third time to clear. Requiring platforms also excludes releases with an unrecognized platform, as with resolution and codec restrictions."
          }
        }
      }
    },
    "subscription.rules.hdrHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下 = 只要，再点 = 排除，第三下取消。\"SDR\" 指资源没标注任何 HDR 格式；\"DV P5\" 是只标了 DV、没有 HDR10 兼容层的杜比视界（转码会偏色），只能排除，点一下即排除；都不选 = 不限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下 = 只要，再点 = 排除，第三下取消。\"SDR\" 指资源没标注任何 HDR 格式；\"DV P5\" 是只标了 DV、没有 HDR10 兼容层的杜比视界（转码会偏色），只能排除，点一下即排除；都不选 = 不限"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to require, tap again to exclude, and a third time to clear. “SDR” means no HDR format is declared. “DV P5” is Dolby Vision without an HDR10 fallback layer (colors shift when transcoded); it can only be excluded, so one tap excludes it. Leave empty for no restriction."
          }
        }
      }
    },
