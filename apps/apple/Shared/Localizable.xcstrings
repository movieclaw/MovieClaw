    "auth.accounts.signOutAllServers": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机登录过的 %lld 个账号（%lld 台服务器）都会退出登录，再回来需要逐个重新输入密码。共用设备时建议这样做。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本机登录过的 %lld 个账号（%lld 台服务器）都会退出登录，再回来需要逐个重新输入密码。共用设备时建议这样做。"
          }
        },
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "All %lld account signed in on this device (%lld servers) will be signed out. You will need to enter each password again. Recommended on shared devices."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "All %lld accounts signed in on this device (%lld servers) will be signed out. You will need to enter each password again. Recommended on shared devices."
                }
              }
            }
          }
        },
        "de": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Alle %lld Konten, die auf diesem Gerät angemeldet sind (%lld Server), werden abgemeldet. Jedes Passwort muss erneut eingegeben werden. Empfohlen auf gemeinsam genutzten Geräten."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Alle %lld Konten, die auf diesem Gerät angemeldet sind (%lld Server), werden abgemeldet. Jedes Passwort muss erneut eingegeben werden. Empfohlen auf gemeinsam genutzten Geräten."
                }
