    "settings.imageSources.priorityHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先匹配语言，同一语言有多个来源时才按这里的顺序选择。季海报仅用于剧集，语言跟随海报设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先匹配语言，同一语言有多个来源时才按这里的顺序选择。季海报仅用于剧集，语言跟随海报设置。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Language is matched first; this order applies only when one language has several sources. Season posters are for TV only and follow the poster language."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sprache wird zuerst abgeglichen; diese Reihenfolge gilt nur dann, wenn eine Sprache mehrere Quellen hat. Staffelposters gelten nur für TV und folgen der Poster-Sprache."
          }
