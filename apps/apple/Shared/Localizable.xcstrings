    "settings.mcp.controls.rotateDescription": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "会生成一枚新令牌，旧令牌立即失效。已接入的客户端都要更新配置，否则会开始报 401。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "会生成一枚新令牌，旧令牌立即失效。已接入的客户端都要更新配置，否则会开始报 401。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A new token will be generated and the old one will stop working immediately. Update every connected client to avoid HTTP 401 errors."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es wird ein neues Token erzeugt, das alte funktioniert sofort nicht mehr. Aktualisiere jeden verbundenen Client, um HTTP-401-Fehler zu vermeiden."
          }
        }
      }
    },
