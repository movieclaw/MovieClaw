    "settings.scrapeCards.thresholdHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单位为像素，0 表示不限制。低于门槛的候选图不选；候选全部不达标时自动放宽。"
          }
        },
        "zh-Hant": {
