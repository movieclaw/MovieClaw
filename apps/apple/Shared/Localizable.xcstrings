    "library.duplicates.bulkUnknown": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一组机器没比出档位：留下的那个只是按实测码率、来源、文件名挑的，不是画质判断。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "这一组机器没比出档位：留下的那个只是按实测码率、来源、文件名挑的，不是画质判断。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quality tiers could not be compared in this group. The recommended file was chosen using measured bitrate, origin and filename; it is not a picture-quality judgment."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Qualitätsstufen ließen sich in dieser Gruppe nicht vergleichen. Die empfohlene Datei wurde anhand gemessener Bitrate, Herkunft und Dateiname gewählt; das ist kein Urteil über die Bildqualität."
          }
        }
      }
    },
