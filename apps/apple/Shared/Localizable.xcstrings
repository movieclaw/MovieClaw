    "activity.taskCenter.deleteFilesHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "包括已下载和未完成的数据；若文件仍由下载器管理，即使已经入库也可能被删除，且无法恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "包括已下载和未完成的数据；若文件仍由下载器管理，即使已经入库也可能被删除，且无法恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Includes completed and unfinished data. Files still managed by the downloader may be deleted even if already imported, and cannot be recovered."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umfasst fertige und unfertige Daten. Dateien, die noch vom Downloader verwaltet werden, können gelöscht werden, auch wenn sie bereits importiert sind – und lassen sich nicht wiederherstellen."
          }
        }
      }
    },
    "activity.taskCenter.keepSubscriptionHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关联订阅会保留原工单身份；巡检确认任务无进度后会按换源策略寻找替代源。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "关联订阅会保留原工单身份；巡检确认任务无进度后会按换源策略寻找替代源。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Linked subscriptions keep the original wanted-item identity. After a scan confirms no progress, the replacement policy will look for another source."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verknüpfte Abos behalten die ursprüngliche Zuordnung des gesuchten Eintrags. Bestätigt ein Scan, dass es keinen Fortschritt gibt, sucht die Ersetzungsrichtlinie nach einer anderen Quelle."
          }
        }
      }
    },
