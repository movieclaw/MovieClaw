    "library.form.coverHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐 21:10 的横图（如 1260×600）。上传的图会自动压缩（长边 1600 的 JPEG），控制台与播放器（Jellyfin 客户端）用的是同一张。上传后立即生效，无需点保存。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "推荐 21:10 的横图（如 1260×600）。上传的图会自动压缩（长边 1600 的 JPEG），控制台与播放器（Jellyfin 客户端）用的是同一张。上传后立即生效，无需点保存。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a 21:10 landscape image, such as 1260×600. Uploads are compressed to JPEG with a 1600 px long edge, and the dashboard and Jellyfin clients use the same cover. It takes effect immediately; no need to save."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze ein Bild im Querformat 21:10, etwa 1260×600. Hochgeladene Bilder werden als JPEG mit 1600 px an der langen Kante gespeichert. Das Dashboard und Jellyfin-Clients zeigen dasselbe Cover. Die Änderung gilt sofort."
          }
        }
      },
      "comment": "Cover upload hint."
    },
