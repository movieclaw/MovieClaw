      }
    },
    "errors.network.untrustedCertificate": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的 HTTPS 证书不受信任（常见于自签名证书）：请换用正规证书（如 Let's Encrypt），或改用 http 地址"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的 HTTPS 证书不受信任（常见于自签名证书）：请换用正规证书（如 Let's Encrypt），或改用 http 地址"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The HTTPS certificate for %@ is not trusted, often because it is self-signed. Use a trusted certificate, such as Let's Encrypt, or an HTTP address."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das HTTPS-Zertifikat für %@ gilt als nicht vertrauenswürdig, etwa weil es selbst signiert ist. Verwende ein vertrauenswürdiges Zertifikat, zum Beispiel von Let's Encrypt, oder eine HTTP-Adresse."
          }
        }
      }
    },
    "errors.network.expiredCertificate": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的 HTTPS 证书已过期或尚未生效：请续签证书，并确认%@的日期与时间正确"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@的 HTTPS 证书已过期或尚未生效：请续签证书，并确认%@的日期与时间正确"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The HTTPS certificate for %@ has expired or is not valid yet. Renew it and check the date and time on your %@."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das HTTPS-Zertifikat für %@ ist abgelaufen oder noch nicht gültig. Erneuere es und prüfe Datum und Uhrzeit auf %@."
          }
        }
      }
    },
    "errors.network.clientCertificate": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@要求客户端证书，App 暂不支持：请在反向代理上关闭客户端证书校验"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@要求客户端证书，App 暂不支持：请在反向代理上关闭客户端证书校验"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ requires a client certificate, which this app does not support. Disable client certificate verification in the reverse proxy."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ verlangt ein Clientzertifikat, das diese App nicht unterstützt. Deaktiviere die Prüfung von Clientzertifikaten im Reverse Proxy."
          }
        }
      }
    },
    "errors.network.redirectLoop": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@重定向次数过多：多半是反向代理的 http / https 跳转配置成了循环"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@重定向次数过多：多半是反向代理的 http / https 跳转配置成了循环"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ redirected too many times. Check the HTTP/HTTPS redirect rules in the reverse proxy for a loop."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde zu oft umgeleitet. Prüfe die HTTP-/HTTPS-Regeln des Reverse Proxys auf Weiterleitungsschleifen."
          }
        }
      }
    },
    "errors.network.badResponse": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@返回了无法识别的响应：地址可能指向了别的服务，或反向代理配置有误"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@返回了无法识别的响应：地址可能指向了别的服务，或反向代理配置有误"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ returned an unrecognized response. The address may point to another service, or the reverse proxy may be misconfigured."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hat eine unerwartete Antwort geliefert. Die Adresse verweist möglicherweise auf einen anderen Dienst oder die Konfiguration des Reverse Proxys ist fehlerhaft."
          }
        }
      }
    },
