    "player.errors.nativeConsentHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "开关可能没有生效（例如服务端刚重启）。请退出重试；若反复出现，请查看服务端日志排查。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "开关可能没有生效（例如服务端刚重启）。请退出重试；若反复出现，请查看服务端日志排查。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The setting may not have taken effect, for example after a server restart. Exit and try again. If this continues, check the server logs."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellung ist möglicherweise noch nicht aktiv, etwa nach einem Serverneustart. Beende die Wiedergabe und versuche es erneut. Tritt das Problem weiter auf, prüfe die Serverprotokolle."
          }
        }
      }
    },
