    "library.form.networkWatchHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到根路径在网络挂载（NFS/SMB）上：这里收不到远端的变化通知，开着也不会建监听。新文件由定期对账发现（可在「设置 → 应用 → 定时任务」调周期，增量对账通常只需几秒）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "检测到根路径在网络挂载（NFS/SMB）上：这里收不到远端的变化通知，开着也不会建监听。新文件由定期对账发现（可在「设置 → 应用 → 定时任务」调周期，增量对账通常只需几秒）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The root is on a network mount (NFS/SMB), which does not deliver remote change notifications. No watcher is created even when this is on. Scheduled reconciliation finds new files; change its interval in Settings → Application → Scheduled tasks. Incremental checks usually take seconds."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Stammordner liegt auf einem Netzlaufwerk (NFS/SMB), das keine Änderungsbenachrichtigungen liefert. Es wird kein Watcher angelegt, auch wenn das hier an ist. Ein geplanter Abgleich findet neue Dateien; das Intervall änderst du unter Einstellungen → Anwendung → Geplante Aufgaben. Inkrementelle Prüfungen dauern meist nur Sekunden."
          }
        }
      }
    },
    "library.form.watchHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "新文件落盘后自动增量扫描入库。SMB/NFS 等网络挂载收不到远端变化通知、建立监听还很慢，建议关闭；关闭后由定期对账和手动扫描发现新文件，不实时但不会缺失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "新文件落盘后自动增量扫描入库。SMB/NFS 等网络挂载收不到远端变化通知、建立监听还很慢，建议关闭；关闭后由定期对账和手动扫描发现新文件，不实时但不会缺失。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically scan and add new files when they arrive. SMB/NFS mounts do not deliver remote change notifications and take time to set up watchers, so monitoring should be turned off for them. Scheduled checks and manual scans still find every new file, with a delay."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Neue Dateien automatisch scannen und hinzufügen, sobald sie eintreffen. SMB-/NFS-Laufwerke liefern keine Änderungsbenachrichtigungen und brauchen lange, um Watcher einzurichten; dort sollte die Überwachung daher aus sein. Geplante Prüfungen und manuelle Scans finden trotzdem jede neue Datei, nur mit Verzögerung."
          }
        }
      }
    },
    "library.form.clearMissingAfterScan": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描后自动清理丢失记录"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "扫描后自动清理丢失记录"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically clear missing records after scans"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fehlende Einträge nach Scans automatisch entfernen"
          }
        }
      }
    },
    "library.form.clearMissingHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自己在磁盘上删了片子后，扫描结束即把这些记录清出台账。只删记录、不动磁盘，但记录删了不可恢复——「缺失」清单里的「重新下载」也会随之消失。关闭时记录保留，文件回归自动恢复；目录读不动的那一轮不会清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自己在磁盘上删了片子后，扫描结束即把这些记录清出台账。只删记录、不动磁盘，但记录删了不可恢复——「缺失」清单里的「重新下载」也会随之消失。关闭时记录保留，文件回归自动恢复；目录读不动的那一轮不会清理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After files are deleted from disk, clear their records when a scan finishes. Only records are deleted; files on disk are kept. This cannot be undone, and the missing-item redownload action disappears too. When off, records are kept and restored when files return. Scans that cannot read a folder never clear its records."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wurden Dateien von der Festplatte gelöscht, werden ihre Einträge nach Abschluss eines Scans entfernt. Gelöscht werden nur die Einträge; die Dateien auf der Festplatte bleiben. Das lässt sich nicht rückgängig machen, und auch die Aktion zum erneuten Herunterladen fehlender Einträge verschwindet. Ist es aus, bleiben die Einträge erhalten und werden wiederhergestellt, wenn die Dateien zurückkehren. Scans, die einen Ordner nicht lesen können, entfernen nie dessen Einträge."
          }
        }
      }
    },
    "library.form.frameFallback": {
      "extractionState": "manual",
      "generatesSymbol": true,
