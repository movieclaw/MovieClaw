    "settings.about.tmdbCredit": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "影视资料与图片由你的服务器从 TMDB（themoviedb.org）等来源获取。本产品使用 TMDB API，但未经 TMDB 认可或认证。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "影视资料与图片由你的服务器从 TMDB（themoviedb.org）等来源获取。本产品使用 TMDB API，但未经 TMDB 认可或认证。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your server retrieves media information and images from sources including TMDB (themoviedb.org). This product uses the TMDB API but is not endorsed or certified by TMDB."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Server erhält Medieninformationen und Bilder aus Quellen, darunter TMDB (themoviedb.org). Dieses Produkt verwendet die TMDB-API, ist jedoch nicht von TMDB empfohlen oder zertifiziert."
          }
        }
      }
    },
    "settings.about.privacySummary": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "MovieClaw 是自托管服务的客户端：你的媒体、账号与观看记录都在你自己部署的服务器上，App 不向开发者或任何第三方上传数据。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "MovieClaw 是自托管服务的客户端：你的媒体、账号与观看记录都在你自己部署的服务器上，App 不向开发者或任何第三方上传数据。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "MovieClaw is a client for a self-hosted service. Your media, accounts and watch history stay on your own server. The app does not upload data to the developer or any third party."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "MovieClaw verbindet sich mit deinem selbst gehosteten Dienst. Medien, Konten und Wiedergabeverlauf bleiben auf deinem eigenen Server. Die App überträgt keine Daten an den Entwickler oder an Dritte."
          }
        }
      }
    },
