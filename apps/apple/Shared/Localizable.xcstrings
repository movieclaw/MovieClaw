    "settings.update.ui.restartConfirmHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重启期间服务短暂不可用，正在进行的下载投递/整理任务会中断。Docker 部署通常几秒内自动拉起；源码部署需有 systemd 等守护。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "重启期间服务短暂不可用，正在进行的下载投递/整理任务会中断。Docker 部署通常几秒内自动拉起；源码部署需有 systemd 等守护。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The service will be briefly unavailable and ongoing download delivery or organization tasks will be interrupted. Docker deployments usually restart within seconds; source deployments need a supervisor such as systemd."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Dienst ist kurz nicht verfügbar, und laufende Übergaben oder Organisationsaufgaben von Downloads werden unterbrochen. Docker-Installationen starten meist innerhalb von Sekunden neu; Installationen aus dem Quellcode brauchen einen Supervisor wie systemd."
          }
        }
      }
    },
