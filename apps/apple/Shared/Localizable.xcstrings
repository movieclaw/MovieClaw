    "library.reidentify.extrasDescription": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们会摘掉身份、不再占用库存，之后扫描也不再过问。适合花絮、预告、片段这类本就不该单独成条目的内容。磁盘文件一个字节都不会动，随时可以在「已忽略」清单里恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它们会摘掉身份、不再占用库存，之后扫描也不再过问。适合花絮、预告、片段这类本就不该单独成条目的内容。磁盘文件一个字节都不会动，随时可以在「已忽略」清单里恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their identification is removed and future scans will ignore them. Use this for extras, trailers, or clips that should not be separate titles. Disk files stay untouched. You can restore them from Ignored at any time."
          }
        }
      }
    },
