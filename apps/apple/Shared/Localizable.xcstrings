    "subscription.rules.resolutionHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击依次选择，先选的优先（选中顺序 = 下载偏好）；不选 = 不限。限定分辨率后，无法从种子名识别出分辨率的资源也会被排除，可用「手动选种」兜底"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "点击依次选择，先选的优先（选中顺序 = 下载偏好）；不选 = 不限。限定分辨率后，无法从种子名识别出分辨率的资源也会被排除，可用「手动选种」兜底"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select in preference order, or leave empty for any resolution. Releases with an unrecognized resolution will be excluded when restricted; you can still pick them manually."
          }
        }
      }
    },
    "subscription.rules.sourceHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击依次选择，先选的优先（选中顺序 = 下载偏好）；不选 = 不限。Rip 类 = WEBRip/BDRip，电视录制类 = HDTV/DVD。限定片源后，无法从种子名识别出片源的资源也会被排除，可用「手动选种」兜底"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "点击依次选择，先选的优先（选中顺序 = 下载偏好）；不选 = 不限。Rip 类 = WEBRip/BDRip，电视录制类 = HDTV/DVD。限定片源后，无法从种子名识别出片源的资源也会被排除，可用「手动选种」兜底"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select in preference order, or leave empty for any source. Rips include WEBRip/BDRip; TV recordings include HDTV/DVD. Restricted sources exclude unrecognized releases; you can still pick them manually."
          }
        }
      }
    },
