    "library.form.scrapedFrameHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未识别文件的封面、以及 TMDB 没有剧照的分集，从视频本身抓一帧顶上；TMDB 有图时始终用 TMDB 的。网络挂载库抓帧需要读取每个文件，介意流量可关闭，关闭后显示占位图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未识别文件的封面、以及 TMDB 没有剧照的分集，从视频本身抓一帧顶上；TMDB 有图时始终用 TMDB 的。网络挂载库抓帧需要读取每个文件，介意流量可关闭，关闭后显示占位图。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a frame from the video for unidentified files and episodes without a TMDB still. Prefer TMDB images whenever available. Frame capture reads each file on network mounts; turn it off to save traffic and show placeholders instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für nicht identifizierte Dateien und Folgen ohne TMDB-Standbild wird ein Frame aus dem Video verwendet. TMDB-Bilder haben immer Vorrang, wenn vorhanden. Auf Netzlaufwerken wird für die Frame-Erfassung jede Datei gelesen; schalte es aus, um Datenverkehr zu sparen, dann erscheinen Platzhalter."
          }
        }
      }
    },
    "library.form.localFrameHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有在线海报的内容从视频本身抓一帧当封面：优先用同名图片或内嵌封面，没有再抓帧。网络挂载库抓帧需要读取每个文件，介意流量可关闭，关闭后显示占位图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "没有在线海报的内容从视频本身抓一帧当封面：优先用同名图片或内嵌封面，没有再抓帧。网络挂载库抓帧需要读取每个文件，介意流量可关闭，关闭后显示占位图。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a video frame when no online poster is available. Prefer a matching image file or embedded cover before capturing a frame. Frame capture reads each file on network mounts; turn it off to save traffic and show placeholders instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Videoframe wird verwendet, wenn kein Online-Poster verfügbar ist. Eine passende Bilddatei oder ein eingebettetes Cover hat Vorrang vor einem Frame. Auf Netzlaufwerken wird für die Frame-Erfassung jede Datei gelesen; schalte es aus, um Datenverkehr zu sparen, dann erscheinen Platzhalter."
          }
        }
      }
    },
    "library.form.thumbnailHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把原图缩到长边 720 像素当相册墙上的缩略图，网格只加载缩略图。关闭后墙会直接加载原图，大照片会很慢；只有网络挂载的大库介意流量时才建议关。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把原图缩到长边 720 像素当相册墙上的缩略图，网格只加载缩略图。关闭后墙会直接加载原图，大照片会很慢；只有网络挂载的大库介意流量时才建议关。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Resize originals to a 720 px long edge for album-wall thumbnails. The grid only loads thumbnails. When off, it loads originals, which can be slow for large photos. Only turn this off to save traffic on large network-mounted libraries."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Originale werden für die Album-Wand auf 720 px lange Kante verkleinert. Das Raster lädt nur Vorschaubilder. Ist es aus, werden Originale geladen, was bei großen Fotos langsam sein kann. Schalte es nur aus, um bei großen Mediatheken auf Netzlaufwerken Datenverkehr zu sparen."
          }
        }
      }
    },
