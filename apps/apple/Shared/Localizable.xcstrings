    },
    "settings.appearance.systemHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置中为 MovieClaw 单独选择语言。若没有该选项，请先在「通用 → 语言与地区」添加语言。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置中为 MovieClaw 单独选择语言。若没有该选项，请先在「通用 → 语言与地区」添加语言。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a language for MovieClaw in Settings. If the option is missing, add a language under General > Language & Region first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Sprache für MovieClaw in den Einstellungen. Falls die Option fehlt, füge eine Sprache unter Allgemein > Sprache & Region zuerst hinzu."
          }
        }
      },
      "comment": "iPhone/iPad help when the per-app language option is missing."
    },
    "settings.appearance.macHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置的「通用 → 语言与地区 → 应用程序」中选择 MovieClaw 的语言，重新打开后生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在系统设置的「通用 → 语言与地区 → 应用程序」中选择 MovieClaw 的语言，重新打开后生效。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose a language for MovieClaw under General > Language & Region > Applications in System Settings, then reopen MovieClaw."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Sprache für Movie und MovieClaw unter Allgemein > Sprache & Region > Anwendungen in den Systemeinstellungen, dann öffne MovieClaw erneut."
          }
        }
      },
      "comment": "macOS instructions; language changes apply after reopening the app."
    },
