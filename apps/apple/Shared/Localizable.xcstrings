    "settings.llmForm.customCatalogHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兼容端点没有内置目录，请把端点上部署的模型添加进来（含参数）。接入后这些模型可在 AI 设定与对话框里选用；连接测试用第一个。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兼容端点没有内置目录，请把端点上部署的模型添加进来（含参数）。接入后这些模型可在 AI 设定与对话框里选用；连接测试用第一个。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatible endpoints have no built-in catalog. Add the models deployed on the endpoint, with parameters. They can then be chosen in AI settings and conversations; the connection test uses the first one."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompatible Endpunkte haben keinen integrierten Katalog. Füge die am Endpunkt verfügbaren Modelle samt Parametern hinzu. Die Modelle stehen anschließend in den KI-Einstellungen und in Unterhaltungen zur Auswahl. Der Verbindungstest verwendet das erste Modell."
          }
        }
      },
      "comment": "Settings."
    },
