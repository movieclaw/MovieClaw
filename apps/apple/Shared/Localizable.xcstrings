    "settings.pushChannels.introLead": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接入的通道是你的通知渠道，收哪些通知和手机 App 一样，在「通知」里设置。能对话的通道里还能直接和 AI 助手聊：发消息即可搜片、订阅、查进度。发送"
          }
