          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnose the cause first. If MovieClaw tools can resolve it safely, run them with the arguments above, preserving every selected parameter. Otherwise, give clear steps. Do not modify the original video file."
