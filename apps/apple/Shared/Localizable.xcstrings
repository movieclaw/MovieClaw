    "library.issues.missingHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件已不在磁盘；「重新下载」交给订阅管线补回，「清理记录」只删台账（都不动磁盘）；文件回归会自动恢复。经常自己删片子的话，可在库设置里打开「扫描后自动清理丢失记录」，以后扫完即对齐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "文件已不在磁盘；「重新下载」交给订阅管线补回，「清理记录」只删台账（都不动磁盘）；文件回归会自动恢复。经常自己删片子的话，可在库设置里打开「扫描后自动清理丢失记录」，以后扫完即对齐。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The files are no longer on disk. Download again asks subscriptions to replace them; Clear records only removes library records. Neither changes files on disk. Returning files recover automatically. If you often delete files yourself, enable Auto-clear missing records after scan in library settings."
          }
        }
      }
    },
    "library.issues.assignHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一目录的文件聚成一组，认领一次整组生效；点候选可先核对海报简介再确认。状态标签悬停看完整原因。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "同一目录的文件聚成一组，认领一次整组生效；点候选可先核对海报简介再确认。状态标签悬停看完整原因。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files in the same directory form a group. Assigning an identity applies to the whole group. Select a candidate to check its poster and overview first. Hover over a status label for the full reason."
          }
        }
      }
    },
    "library.issues.reviewHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "识别器升级后重新核对了这些条目，新结论与现有身份不一致。身份没有被自动改动——由你拍板：采纳新结论改挂条目，或维持现状。拍板后不再提醒。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "识别器升级后重新核对了这些条目，新结论与现有身份不一致。身份没有被自动改动——由你拍板：采纳新结论改挂条目，或维持现状。拍板后不再提醒。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An updated identifier found a different identity for these titles. Nothing changed automatically. Accept the new identity or keep the current one; your decision dismisses this review."
          }
        }
      }
    },
    "library.issues.ignoredHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些文件你选择过「忽略」，之后每次扫描都会直接跳过，不再占用待识别清单（磁盘文件一直都在）。识别器在持续变强，当初认不出的现在未必认不出——「恢复」即可让它重新参与识别。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "这些文件你选择过「忽略」，之后每次扫描都会直接跳过，不再占用待识别清单（磁盘文件一直都在）。识别器在持续变强，当初认不出的现在未必认不出——「恢复」即可让它重新参与识别。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You chose to ignore these files. Scans skip them, and they stay out of the unidentified list. Disk files remain untouched. Identification keeps improving; Restore lets a file be identified again."
          }
        }
      }
    },
