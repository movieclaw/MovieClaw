    "settings.imChannels.unbindDescription": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "解绑后停止收发、删除凭据，需要重新绑定才能使用；历史对话保留。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "解绑后停止收发、删除凭据，需要重新绑定才能使用；历史对话保留。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Unlinking stops messages and removes credentials. Link the account again to use it. Conversation history is kept."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Trennen enden die Nachrichten und die Zugangsdaten werden entfernt. Verknüpfe das Konto erneut, um es zu nutzen. Der Unterhaltungsverlauf bleibt erhalten."
          }
