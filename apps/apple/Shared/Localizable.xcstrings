    "settings.networkUi.mappingNote": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前通过端口 %@ 访问，服务器监听 %@，中间存在端口映射或反向代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "当前通过端口 %@ 访问，服务器监听 %@，中间存在端口映射或反向代理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are connected through port %1$@ while the server listens on %2$@, so a port mapping or reverse proxy is in between. "
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist über Port %1$@ verbunden, während der Server auf %2$@ lauscht, also liegt eine Port-Mapping oder ein Reverse-Proxy dazwischen. "
          }
        }
      },
      "comment": "Confirmation detail; followed by the main text."
    },
    "settings.networkUi.restartConfirm": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器将重启并监听端口 %@，当前地址可能失效。%@Docker bridge 部署必须同步修改 compose 中 ports 的容器侧端口并重建容器；反向代理必须调整目标端口。只想改变访问端口时，可直接调整映射或反向代理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器将重启并监听端口 %@，当前地址可能失效。%@Docker bridge 部署必须同步修改 compose 中 ports 的容器侧端口并重建容器；反向代理必须调整目标端口。只想改变访问端口时，可直接调整映射或反向代理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server will restart and listen on port %1$@, and the current address may stop working. %2$@With Docker bridge networking, also change the container-side port in compose and recreate the container; update the reverse proxy’s target port. To change only the port you connect through, adjust the mapping or reverse proxy instead."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server startet neu und lauscht auf Port %1$@. Die aktuelle Adresse funktioniert danach möglicherweise nicht mehr. %2$@Ändere bei Docker mit Bridge-Netzwerk außerdem den Container-Port in der Compose-Datei und erstelle den Container neu. Passe den Zielport des Reverse Proxys an. Wenn du nur den Port für die Verbindung ändern möchtest, ändere die Portzuordnung oder den Reverse Proxy."
          }
        }
      },
      "comment": "Confirmation message."
    },
