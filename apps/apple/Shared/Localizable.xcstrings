    "activity.watchHistory.noHistoryHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从现在起每一场播放都会记在这里：谁、什么时候、用什么设备、看到哪、看了多久。网页播放器和 Jellyfin 客户端都算。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "从现在起每一场播放都会记在这里：谁、什么时候、用什么设备、看到哪、看了多久。网页播放器和 Jellyfin 客户端都算。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each play is recorded from now on: who watched, when, on which device, progress and time watched. Includes the web player and Jellyfin clients."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab jetzt wird jede Wiedergabe erfasst: wer geschaut hat, wann, auf welchem Gerät, mit welchem Fortschritt und wie lange. Inklusive Web-Player und Jellyfin-Clients."
          }
        }
      }
    },
