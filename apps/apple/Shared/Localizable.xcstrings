    "subscription.subscribe.upgradeDescription": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "洗版通过订阅持续追踪更好的版本：确认后建立订阅并立即体检库里已有的每一集。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "洗版通过订阅持续追踪更好的版本：确认后建立订阅并立即体检库里已有的每一集。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscriptions keep looking for better releases. Confirm to subscribe and immediately check each episode already in your library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abos suchen weiter nach besseren Releases. Bestätige, um zu abonnieren und sofort jede Folge zu prüfen, die bereits in deiner Mediathek ist."
          }
        }
      }
    },
    "subscription.subscribe.notFound": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDB 未收录该条目，暂时无法订阅。订阅依赖 TMDB 的别名与季集数据来匹配站点资源，可尝试在 TMDB 搜索入口确认条目后再订阅。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "TMDB 未收录该条目，暂时无法订阅。订阅依赖 TMDB 的别名与季集数据来匹配站点资源，可尝试在 TMDB 搜索入口确认条目后再订阅。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This title is not listed on TMDB, so it cannot be subscribed to yet. Subscriptions use TMDB aliases and episode data to match releases. Try confirming the title through TMDB search first."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Titel ist nicht auf TMDB gelistet und kann daher noch nicht abonniert werden. Abos nutzen die Alias- und Folgendaten von TMDB, um Releases zuzuordnen. Versuche, den Titel zuerst über die TMDB-Suche zu bestätigen."
          }
        }
      }
    },
