    "settings.updateUi.rollbackHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回退会重启应用；是否需要恢复数据备份取决于目标版本的数据结构差异，结论已在每一项里标明。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回退会重启应用；是否需要恢复数据备份取决于目标版本的数据结构差异，结论已在每一项里标明。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rolling back restarts the app. Whether a data backup must be restored depends on the target version’s database structure, as shown for each version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beim Rollback startet die App neu. Ob ein Daten-Backup wiederhergestellt werden muss, hängt von der Datenbankstruktur der Zielversion ab – das steht bei jeder Version."
          }
        }
      },
      "comment": "App update settings."
    },
    "settings.updateUi.noBackup": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可对应时点的数据备份：切换后该版本将直接使用当前数据，若中间经过数据库升级可能无法正常运行（启动失败时会自动回落）。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可对应时点的数据备份：切换后该版本将直接使用当前数据，若中间经过数据库升级可能无法正常运行（启动失败时会自动回落）。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no matching data backup. The version will use current data and may not work after database upgrades; startup failures roll back automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es gibt kein passendes Backup. Die Version nutzt den aktuellen Datenbestand. Nach Datenbank-Upgrades funktioniert sie möglicherweise nicht. Schlägt der Start fehl, wird automatisch die vorherige Version wiederhergestellt."
          }
        }
      },
      "comment": "App update settings."
    },
