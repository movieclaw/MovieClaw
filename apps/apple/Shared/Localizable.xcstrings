    "library.manage.overlapSameFields": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两库已声明相同的维度：错开重叠的取值即可消除歧义。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "两库已声明相同的维度：错开重叠的取值即可消除歧义。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Both libraries use the same dimensions. Remove the overlapping values to avoid ambiguity."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beide Mediatheken verwenden die gleichen Dimensionen. Entferne die überschneidenden Werte, um Unklarheiten zu vermeiden."
          }
        }
      },
      "comment": "Overlap fix."
    },
    "library.manage.overlapAddFields": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想让「%@」优先收这类作品：编辑它，补上「%@」条件（用「全选」也可以）——条件多的库优先命中；想维持现状则无需改动。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "想让「%@」优先收这类作品：编辑它，补上「%@」条件（用「全选」也可以）——条件多的库优先命中；想维持现状则无需改动。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "To make “%1$@” receive these titles first, edit it and add a %2$@ condition (Select all also works). Libraries with more conditions match first; no change is needed to keep the current behavior."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Damit „%1$@“ diese Titel zuerst erhält, bearbeite die Mediathek und füge eine Bedingung für %2$@ hinzu. „Alle auswählen“ funktioniert ebenfalls. Mediatheken mit mehr passenden Bedingungen haben Vorrang. Um das aktuelle Verhalten zu behalten, brauchst du nichts zu ändern."
          }
        }
      },
      "comment": "Overlap fix."
    },
    "library.manage.overlapWarning": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」与「%@」的收藏范围可能同时命中同一部作品且条件数相同，届时优先进创建更早的「%@」。%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」与「%@」的收藏范围可能同时命中同一部作品且条件数相同，届时优先进创建更早的「%@」。%@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” and “%2$@” may both match the same title with the same number of conditions. The earlier library, “%3$@”, receives it. %4$@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„%1$@“ und „%2$@“ können beide mit derselben Zahl an Bedingungen auf denselben Titel zutreffen. Die weiter oben stehende Mediathek „%3$@“ erhält den Titel. %4$@"
          }
        }
      },
      "comment": "Overlap warning."
    },
    "library.organize.introNamed": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按刮削结果把存量文件改名归位为「标题 (年份)%@/规范文件名」，Plex / Emby 零歧义识别；字幕等附属文件同步改名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按刮削结果把存量文件改名归位为「标题 (年份)%@/规范文件名」，Plex / Emby 零歧义识别；字幕等附属文件同步改名。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rename existing files from their metadata to “Title (Year)%@/Standard filename” so Plex and Emby identify them reliably. Matching subtitles and sidecar files are renamed too."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Metadaten werden verwendet, um vorhandene Dateien als „Titel (Jahr)%@/Standarddateiname“ zu benennen. So erkennen Plex und Emby sie zuverlässig. Passende Untertitel und Begleitdateien werden ebenfalls umbenannt."
          }
        }
      },
      "comment": "Organize intro."
    },
    "library.organize.noUndoMarkdown": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "改名直接发生在磁盘上，**无法一键撤销**；下方清单就是将要发生的全部变更。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "改名直接发生在磁盘上，**无法一键撤销**；下方清单就是将要发生的全部变更。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Files are renamed on disk. **There is no one-click undo.** The list below shows every planned change."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Dateien werden auf der Festplatte umbenannt. **Es gibt keine ein-klick-Rückgängigmachung.** Die Liste unten zeigt alle geplanten Änderungen."
          }
        }
      },
      "comment": "Markdown bullet."
    },
    "library.organize.seedingMarkdown": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "**正在下载器中做种的文件，改名后做种会失败**——请确认这些文件已不在做种，或接受改名后到下载器里重新校验。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "**正在下载器中做种的文件，改名后做种会失败**——请确认这些文件已不在做种，或接受改名后到下载器里重新校验。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "**Renaming files that are being seeded will interrupt seeding.** Stop seeding first, or recheck the files in your downloader afterward."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "**Die Umbenennung von Dateien, die gerade geseedet werden, unterbricht das Seeding.** Stoppe das Seeding zuerst oder prüfe die Dateien in deinem Downloader danach."
          }
        }
      },
      "comment": "Markdown bullet."
    },
