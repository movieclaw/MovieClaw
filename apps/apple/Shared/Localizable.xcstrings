          "stringUnit": {
            "state": "translated",
            "value": " 删除不可撤销；若其中有文件仍在下载器里做种，删除会中断做种任务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": " 删除不可撤销；若其中有文件仍在下载器里做种，删除会中断做种任务。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": " Deletion cannot be undone. If any files are still being seeded by a downloader, deleting them will interrupt seeding."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": " Das Löschen lässt sich nicht rückgängig machen. Werden Dateien noch von einem Downloader geseedet, unterbricht das Löschen das Seeding."
