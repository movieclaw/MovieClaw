    "settings.members.actions.deleteHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头像、播放进度等个人数据会被清理；订阅转由管理员接管，已下载内容不受影响。此操作不可恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "头像、播放进度等个人数据会被清理；订阅转由管理员接管，已下载内容不受影响。此操作不可恢复。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Personal data, including the avatar and playback progress, will be deleted. The administrator takes over the subscriptions, and downloaded content is kept. This cannot be undone."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Persönliche Daten, auch Avatar und Wiedergabefortschritt, werden gelöscht. Der Administrator übernimmt die Abos, heruntergeladene Inhalte bleiben erhalten. Das lässt sich nicht rückgängig machen."
          }
        }
      }
    },
