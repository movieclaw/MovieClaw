    "library.personEmptyHintWeb": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能是这位影人参演的片都已从库里移除；也可能这个库是早前扫描的——影人档案随入库刮削一并建立，在网页上对这个库执行一次「刷新元数据」即可补齐。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可能是这位影人参演的片都已从库里移除；也可能这个库是早前扫描的——影人档案随入库刮削一并建立，在网页上对这个库执行一次「刷新元数据」即可补齐。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their titles may have been removed, or the library may have been scanned before person details were supported. Run Refresh metadata for the library on the web to fill them in."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Titel wurden möglicherweise entfernt oder die Mediathek wurde gescannt, bevor Personeninformationen unterstützt wurden. Wähle im Web für die Mediathek „Metadaten aktualisieren“, um die Angaben nachzutragen."
          }
        }
      }
    },
    "library.personEmptyHintPhone": {
      "extractionState": "manual",
