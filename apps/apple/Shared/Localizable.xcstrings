    "activity.watchHistory.noMemberHistoryHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从这位成员下一次播放起，谁、什么时候、用什么设备、看了多久都会记在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "从这位成员下一次播放起，谁、什么时候、用什么设备、看了多久都会记在这里。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From this member’s next play, these records show who watched, when, on which device, and for how long."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ab der nächsten Wiedergabe dieses Mitglieds zeigen diese Einträge, wer wann auf welchem Gerät wie lange geschaut hat."
