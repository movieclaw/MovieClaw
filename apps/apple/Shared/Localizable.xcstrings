    "subscription.upgrade.description": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逐集检查《%@》库里已有的版本，低于洗版目标的立即排入搜索；洗到新版本入库并验证通过后，旧文件自动替换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "逐集检查《%@》库里已有的版本，低于洗版目标的立即排入搜索；洗到新版本入库并验证通过后，旧文件自动替换。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Check each library version of “%@”. Queue releases below the upgrade target for search. Old files are replaced after the new release is imported and verified."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Version von „%@“ in der Mediathek wird geprüft. Releases unterhalb des Upgrade-Ziels werden zur Suche eingereiht. Alte Dateien werden ersetzt, sobald das neue Release importiert und geprüft ist."
          }
        }
      }
    },
