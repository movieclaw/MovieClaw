    "errors.network.offlinePhone": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "手机没有联网：请检查 Wi-Fi 或蜂窝网络；如果其他 App 能上网，请到「设置 → MovieClaw」允许它使用无线局域网与蜂窝数据"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "手机没有联网：请检查 Wi-Fi 或蜂窝网络；如果其他 App 能上网，请到「设置 → MovieClaw」允许它使用无线局域网与蜂窝数据"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your phone is offline. Check Wi-Fi or cellular data. If other apps can connect, allow MovieClaw to use Wi-Fi and cellular data in Settings > MovieClaw."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Smartphone ist offline. Prüfe WLAN und mobile Daten. Wenn andere Apps eine Verbindung haben, erlaube MovieClaw unter „Einstellungen → MovieClaw“ den Zugriff auf WLAN und mobile Daten."
          }
        }
      }
    },
    "errors.network.offline": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@没有联网：请检查 Wi-Fi 或有线网络；连的是局域网地址时，还要在「系统设置 → 隐私与安全性 → 本地网络」里允许 MovieClaw"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "%@没有联网：请检查 Wi-Fi 或有线网络；连的是局域网地址时，还要在「系统设置 → 隐私与安全性 → 本地网络」里允许 MovieClaw"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your %@ is offline. Check Wi-Fi or Ethernet. For local addresses, also allow MovieClaw under System Settings > Privacy & Security > Local Network."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist offline. Prüfe WLAN oder Ethernet. Erlaube MovieClaw für lokale Adressen außerdem den Zugriff unter „Systemeinstellungen → Datenschutz & Sicherheit → Lokales Netzwerk“."
          }
        }
      }
    },
    "errors.network.cellularDenied": {
