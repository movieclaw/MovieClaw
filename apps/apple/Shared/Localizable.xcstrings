    "settings.scrape.libraryMirrorHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把刮削成果写入本库的媒体目录。基本信息里的「刮削图片/NFO 写入媒体目录」是总闸，关掉则这三项全不写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把刮削成果写入本库的媒体目录。基本信息里的「刮削图片/NFO 写入媒体目录」是总闸，关掉则这三项全不写。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write scraping results into this library’s media directory. The master switch in Basic information overrides these three settings when disabled."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Scraping-Ergebnisse in das Medienverzeichnis dieser Mediathek schreiben. Ist der Hauptschalter unter „Grundangaben“ aus, setzt er diese drei Einstellungen außer Kraft."
