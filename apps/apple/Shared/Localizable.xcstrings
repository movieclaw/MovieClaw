    "library.collections.hideExplanation": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动生成的合集会一直重新出现，所以这里是把它藏起来：影片一部都不会少，想找回来在媒体库设置里打开「显示已隐藏的合集」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自动生成的合集会一直重新出现，所以这里是把它藏起来：影片一部都不会少，想找回来在媒体库设置里打开「显示已隐藏的合集」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically generated collections keep reappearing, so this hides the collection. All titles stay in your library. To find it again, enable “Show hidden collections” in library settings."
          }
        }
      }
    },
