    "settings.updateUi.restoreHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前数据结构比该版本新（中间经过数据库升级）。回退将恢复 %@ 自动备份的数据，此后产生的数据（订阅活动、入库记录等）将丢失；回退前会再自动备份一次当前数据，切回新版本时可完整还原。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "当前数据结构比该版本新（中间经过数据库升级）。回退将恢复 %@ 自动备份的数据，此后产生的数据（订阅活动、入库记录等）将丢失；回退前会再自动备份一次当前数据，切回新版本时可完整还原。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The database structure is newer than this version because of an intervening upgrade. Rolling back restores the automatic backup from %@; later data, such as subscription activity and import records, will be lost. Current data is backed up first, so switching back to the newer version restores it completely."
          }
        }
      },
      "comment": "Rollback detail."
    },
