          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No library is configured, or its root path is missing. Files will stay in the downloader’s default directory and require manual handling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Es ist keine Mediathek konfiguriert, oder ihr Stammpfad fehlt. Die Dateien bleiben im Standardverzeichnis des Downloaders und müssen manuell bearbeitet werden."
          }
        }
      }
    },
