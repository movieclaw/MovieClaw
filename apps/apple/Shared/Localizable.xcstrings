    "library.deletion.lastFileWarning": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是「%@」在本库的最后一个文件——删除将升级为整条目删除，整个刮削目录（含 NFO/海报）一并清除，条目将从库存消失。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "这是「%@」在本库的最后一个文件——删除将升级为整条目删除，整个刮削目录（含 NFO/海报）一并清除，条目将从库存消失。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the last file for “%@” in this library. Deleting it removes the entire title and its metadata directory, including NFO and posters. The title will disappear from the inventory."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies ist die letzte Datei zu „%@“ in dieser Mediathek. Beim Löschen werden der gesamte Titel und sein Metadatenordner samt NFO-Dateien und Postern entfernt. Der Titel verschwindet aus dem Bestand."
          }
        }
      },
      "comment": "Delete file warning."
    },
