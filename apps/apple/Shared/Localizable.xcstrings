    "settings.macInstall.fromDiskImage": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你现在是直接在安装盘里打开的。请退出后回到安装盘窗口，把 MovieClaw 拖到右边的「应用程序」文件夹，再从「应用程序」或启动台打开。装进去之后才能正常使用，以后也能自动更新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你现在是直接在安装盘里打开的。请退出后回到安装盘窗口，把 MovieClaw 拖到右边的「应用程序」文件夹，再从「应用程序」或启动台打开。装进去之后才能正常使用，以后也能自动更新。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You opened MovieClaw directly from the disk image. Quit, return to the disk image window, drag MovieClaw to the Applications folder on the right, then open it from Applications or Launchpad. MovieClaw works properly and updates automatically only after it’s installed."
          }
        }
      }
    },
