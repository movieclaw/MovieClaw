    "settings.scrape.libraryNamingHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空即跟随全局模板。命名的产物是本库目录树里的路径，所以每个库可以各用一套。全部占位符（原名、集名、视频编码、站点等）与实时预览见「设置 → 刮削与整理 → 命名模板」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空即跟随全局模板。命名的产物是本库目录树里的路径，所以每个库可以各用一套。全部占位符（原名、集名、视频编码、站点等）与实时预览见「设置 → 刮削与整理 → 命名模板」。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave blank to follow the global template. Each library can use its own names within its directory tree. See Settings → Metadata and organization → Naming templates for all tokens (original title, episode title, video codec, site and more) and a live preview."
          }
        }
      }
    },
