      }
    },
    "library.form.clearMissingHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自己在磁盘上删了片子后，扫描结束即把这些记录清出台账。只删记录、不动磁盘，但记录删了不可恢复——「缺失」清单里的「重新下载」也会随之消失。关闭时记录保留，文件回归自动恢复；目录读不动的那一轮不会清理。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自己在磁盘上删了片子后，扫描结束即把这些记录清出台账。只删记录、不动磁盘，但记录删了不可恢复——「缺失」清单里的「重新下载」也会随之消失。关闭时记录保留，文件回归自动恢复；目录读不动的那一轮不会清理。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After files are deleted from disk, clear their records when a scan finishes. Only records are deleted; files on disk are kept. This cannot be undone, and the missing-item redownload action disappears too. When off, records are kept and restored when files return. Scans that cannot read a folder never clear its records."
          }
        }
      }
    },
    "library.form.frameFallback": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
