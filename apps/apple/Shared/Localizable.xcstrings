    "settings.networkUi.manualHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 HTTP、HTTPS、SOCKS5 和 SOCKS5H。地址必须能由服务器访问，保存后立即生效。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "支持 HTTP、HTTPS、SOCKS5 和 SOCKS5H。地址必须能由服务器访问，保存后立即生效。"
          }
        },
        "en": {
          "stringUnit": {
