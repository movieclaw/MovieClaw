          }
        }
      }
    },
    "settings.devices.labels.adminBody": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台机器上的程序将能做你在网页上能做的一切，包括删除媒体文件。只在你清楚这台机器上正在运行什么程序时才批准。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "这台机器上的程序将能做你在网页上能做的一切，包括删除媒体文件。只在你清楚这台机器上正在运行什么程序时才批准。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The program on this machine can do everything you can do on the website, including deleting media files. Only approve if you know what program is running on this machine."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Programm auf diesem Rechner kann alles tun, was du auf der Website tun kannst, auch Mediendateien löschen. Bestätige nur, wenn du weißt, welches Programm auf diesem Rechner läuft."
          }
        }
      }
    },
    "settings.devices.labels.memberTitle": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将获得：与你相同的权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "将获得：与你相同的权限"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Access: The same permissions as you"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zugriff: Dieselben Berechtigungen wie du"
          }
        }
      }
    },
    "settings.devices.labels.manualFullBody": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "持有这枚令牌的程序将能做你在网页上能做的一切，包括删除媒体文件。令牌不会自动过期，只能在这里注销——只把它放进你自己掌握的机器。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "持有这枚令牌的程序将能做你在网页上能做的一切，包括删除媒体文件。令牌不会自动过期，只能在这里注销——只把它放进你自己掌握的机器。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program holding this token can do everything you can do on the website, including deleting media files. The token does not expire automatically and can only be revoked here. Store it only on machines you control."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Programm mit diesem Token kann alles tun, was du auf der Website tun kannst, auch Mediendateien löschen. Das Token läuft nicht automatisch ab und lässt sich nur hier widerrufen. Speichere es nur auf Rechnern, die du kontrollierst."
          }
        }
      }
    },
