    "settings.scrapeCards.languagesHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标题、简介等文本优先使用第 1 位语言，缺失内容按顺序使用其他语言。长按手柄拖动可调整顺序。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "标题、简介等文本优先使用第 1 位语言，缺失内容按顺序使用其他语言。长按手柄拖动可调整顺序。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Titles, overviews and other text use the first language, falling back to the others in order. Long-press a handle to reorder."
          }
        }
      },
      "comment": "Scrape settings cards."
    },
    "settings.scrapeCards.imagesHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先匹配图片语言，同一语言有多个来源时再按来源顺序选择。手动选定的图片始终优先。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先匹配图片语言，同一语言有多个来源时再按来源顺序选择。手动选定的图片始终优先。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Image language is matched first, then source order when one language has several sources. Manually chosen images always win."
          }
        }
      },
      "comment": "Scrape settings cards."
    },
    "settings.scrapeCards.logoHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "片名 Logo 按语言优先级选择，所有语言都没有可用图片时不显示 Logo。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "片名 Logo 按语言优先级选择，所有语言都没有可用图片时不显示 Logo。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Title logos follow the language priority; no logo is shown if no language has one."
          }
        }
      },
      "comment": "Scrape settings cards."
    },
    "settings.scrapeCards.backdropHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "详情页的背景图片按优先级选择。「无文字」优先选择没有片名的背景图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "详情页的背景图片按优先级选择。「无文字」优先选择没有片名的背景图。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Detail page backdrops follow this priority. No text prefers backdrops without a title."
          }
        }
      },
      "comment": "Scrape settings cards."
    },
    "settings.scrapeCards.qualityHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本地图片画质决定刮削时下载到本地的图片多大（默认存原图，各设备都最清楚；调低可显著节省磁盘），改动后在媒体库执行「刷新元数据」会按新画质重下；分辨率门槛过滤模糊候选图。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本地图片画质决定刮削时下载到本地的图片多大（默认存原图，各设备都最清楚；调低可显著节省磁盘），改动后在媒体库执行「刷新元数据」会按新画质重下；分辨率门槛过滤模糊候选图。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Local image quality sets the size of images downloaded during scraping (originals by default, sharpest on every device; lower saves disk space). After a change, Refresh metadata redownloads at the new quality. Resolution thresholds filter out blurry candidates."
          }
        }
      },
      "comment": "Scrape settings cards."
    },
    "settings.scrapeCards.mirrorHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把刮削成果写入媒体目录，反哺 Emby / Jellyfin / Kodi（文件名遵循播放器规范）。只增不删除；已存在的 NFO 绝不覆盖。每个媒体库还有一个总开关，关掉则该库三项都不写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "把刮削成果写入媒体目录，反哺 Emby / Jellyfin / Kodi（文件名遵循播放器规范）。只增不删除；已存在的 NFO 绝不覆盖。每个媒体库还有一个总开关，关掉则该库三项都不写。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write metadata into media directories for Emby, Jellyfin and Kodi, using player naming conventions. Files are only added, never deleted, and existing NFO files are never overwritten. Each library also has a main switch that disables all three."
          }
        }
      },
      "comment": "Scrape settings cards."
    },
