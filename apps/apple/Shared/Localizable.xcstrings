    "library.form.video.defaults": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时监控目录变化、扫描后保留丢失记录、从视频抓帧生成封面、在首页展示。网络挂载的目录建议建好后到「编辑库 → 扫描与监控」关掉实时监控与抓帧。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "实时监控目录变化、扫描后保留丢失记录、从视频抓帧生成封面、在首页展示。网络挂载的目录建议建好后到「编辑库 → 扫描与监控」关掉实时监控与抓帧。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor folder changes, keep missing file records, generate covers from video frames and show this library on the home page. For folders mounted over the network, turn off monitoring and frame capture in Edit library → Scanning and monitoring after creating the library."
          }
        }
      }
    },
    "library.form.photo.defaults": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时监控目录变化、扫描后保留丢失记录、生成缩略图、不在首页展示（批量导入会刷满「最近添加」）。缩略图从原图缩放而来；网络挂载的目录建议建好后到「编辑库 → 扫描与监控」关掉实时监控。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "实时监控目录变化、扫描后保留丢失记录、生成缩略图、不在首页展示（批量导入会刷满「最近添加」）。缩略图从原图缩放而来；网络挂载的目录建议建好后到「编辑库 → 扫描与监控」关掉实时监控。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor folder changes, keep missing file records and generate thumbnails. Hide this library from the home page to avoid filling Recently added during bulk imports. Thumbnails are resized from the originals. For folders mounted over the network, turn off monitoring in Edit library → Scanning and monitoring after creating the library."
          }
        }
      }
    },
