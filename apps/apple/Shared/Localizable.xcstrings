          "stringUnit": {
            "state": "translated",
            "value": "旧密码和网页、App、播放器上的登录会立即失效，已配对的命令行保留。新密码只显示一次。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The old password and sign-ins on the web, apps and players stop working immediately; paired command-line tools are kept. The new password is shown only once."
