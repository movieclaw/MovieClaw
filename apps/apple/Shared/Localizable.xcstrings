          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld min"
          }
        }
      },
      "comment": "Movie runtime in minutes; parameter: count."
    },
    "units.duration.hoursShort": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 小时"
