      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兼容转码器处理需要远程硬件的任务。没有转码器在线时自动使用服务器本地转码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兼容转码器处理需要远程硬件的任务。没有转码器在线时自动使用服务器本地转码。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compatible transcoders handle work that needs remote hardware. When none is online, the server transcodes locally."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kompatible Transkodierer übernehmen Aufgaben, die an Hardware übertragen werden müssen. Wenn kein Transkodierer online ist, erfolgt die Transkodierung lokal auf dem Server."
          }
        }
      },
      "comment": "Playback settings."
    },
    "settings.playback.remote.offHint": {
