    "auth.logout.macDescription": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」在这台 Mac 上的登录会在服务器上一并注销。同一台服务器上还有别的账号时会自动切过去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」在这台 Mac 上的登录会在服务器上一并注销。同一台服务器上还有别的账号时会自动切过去。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session for “%@” on this Mac will also be revoked on the server. If another account on the same server is available, the app will switch to it automatically."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Sitzung für „%@“ auf diesem Mac wird auch auf dem Server widerrufen. Gibt es auf demselben Server ein anderes Konto, wechselt die App automatisch dorthin."
          }
        }
      }
    },
    "auth.logout.tvDescription": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」在这台 Apple TV 上的登录会在服务器上一并注销。同一台服务器上还有别的账号时会自动切过去。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」在这台 Apple TV 上的登录会在服务器上一并注销。同一台服务器上还有别的账号时会自动切过去。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session for “%@” on this Apple TV will also be revoked on the server. If another account on the same server is available, the app will switch to it automatically."
          }
        },
        "de": {
