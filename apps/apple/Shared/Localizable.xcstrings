      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未配置媒体库或库缺少根路径，文件将留在下载器默认目录，需手动处理"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
