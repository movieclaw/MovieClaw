    "settings.llmForm.apiHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-5.6 等推理模型要在调用工具时调节思维链强度，需选 Responses API；端点不支持 /v1/responses 时选 Chat Completions。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "GPT-5.6 等推理模型要在调用工具时调节思维链强度，需选 Responses API；端点不支持 /v1/responses 时选 Chat Completions。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reasoning models such as GPT-5.6 need the Responses API to adjust reasoning effort during tool calls; choose Chat Completions if the endpoint does not support /v1/responses."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Reasoning-Modelle wie GPT-5.6 brauchen die Responses API, um den Denkaufwand bei Tool-Aufrufen anzupassen. Wähle Chat Completions, falls der Endpunkt /v1/responses nicht unterstützt."
          }
        }
      },
      "comment": "Settings."
    },
