    "media.person.emptyLibraryHintText": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可能是他参演的片都已从库里移除；也可能这个库是早前扫描的——影人档案随入库刮削一并建立，对它执行一次「刷新元数据」即可补齐，之后这里就会列出他在库内的全部作品。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "可能是他参演的片都已从库里移除；也可能这个库是早前扫描的——影人档案随入库刮削一并建立，对它执行一次「刷新元数据」即可补齐，之后这里就会列出他在库内的全部作品。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Their titles may have been removed, or the library may have been scanned before person details were supported. Run Refresh metadata for the library to list all of their titles here."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Titel wurden möglicherweise entfernt oder die Mediathek wurde gescannt, bevor Personeninformationen unterstützt wurden. Wähle für die Mediathek „Metadaten aktualisieren“, um alle Titel dieser Person hier anzuzeigen."
          }
        }
      }
    },
