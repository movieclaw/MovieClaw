    "library.transfer.directoryTail": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "（视频、NFO、海报、字幕）会连同库存记录一起搬到目标库；目录名原样保留，需要规范化请到目标库运行「整理文件名」。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "（视频、NFO、海报、字幕）会连同库存记录一起搬到目标库；目录名原样保留，需要规范化请到目标库运行「整理文件名」。"
          }
