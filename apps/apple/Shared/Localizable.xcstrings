    "library.subtitleGeneration.agentInstructions": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先判断原因；如果能通过 MovieClaw 的工具安全解决，请按上面的「对应参数」直接执行（不要换回默认参数），否则给出明确的操作步骤。不要修改影片原文件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "请先判断原因；如果能通过 MovieClaw 的工具安全解决，请按上面的「对应参数」直接执行（不要换回默认参数），否则给出明确的操作步骤。不要修改影片原文件。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Diagnose the cause first. If MovieClaw tools can resolve it safely, run them with the arguments above, preserving every selected parameter. Otherwise, give clear steps. Do not modify the original video file."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ermittle zuerst die Ursache. Lässt sie sich mit MovieClaw-Tools sicher beheben, führe sie mit den obigen Argumenten aus und behalte jeden gewählten Parameter bei. Andernfalls nenne klare Schritte. Verändere die ursprüngliche Videodatei nicht."
          }
        }
      }
    },
