    "activity.watchHistory.allHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有作品的续播进度、已看标记和播放次数都会清除，无法恢复。只影响你自己的记录；应用更新前的自动备份仍包含历史记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有作品的续播进度、已看标记和播放次数都会清除，无法恢复。只影响你自己的记录；应用更新前的自动备份仍包含历史记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress, watched markers and play counts for all items are permanently cleared. Only your own records are affected. Automatic backups from before app updates still contain the history."
          }
        },
        "de": {
