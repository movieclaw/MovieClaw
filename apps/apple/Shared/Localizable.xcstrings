    "subscription.annotate.hint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些文件的文件名里没有可识别的片源标记，系统无法确认它们是否低于洗版目标。看一眼文件名，把你知道的来源告诉系统——标注一次，之后整季自动参与洗版判定。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "这些文件的文件名里没有可识别的片源标记，系统无法确认它们是否低于洗版目标。看一眼文件名，把你知道的来源告诉系统——标注一次，之后整季自动参与洗版判定。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These filenames do not identify their source, so the system cannot compare them with the upgrade target. Check the filenames and identify the source once to include the whole season in upgrade decisions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aus den Dateinamen geht die Quelle nicht hervor. Das System kann sie deshalb nicht mit dem Upgrade-Ziel abgleichen. Prüfe die Dateinamen und lege die Quelle einmal fest, damit die ganze Staffel bei Qualitätsupgrades berücksichtigt wird."
          }
        }
      }
    },
    "subscription.annotate.files": {
