          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn this on to use a Mac’s hardware transcoding. The server still manages playback sessions and caching."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
