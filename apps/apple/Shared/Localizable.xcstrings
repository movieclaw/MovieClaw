    "activity.watchHistory.todayHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天播放过的作品，续播进度、已看标记和播放次数都会清除，无法恢复。只影响你自己的记录。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "今天播放过的作品，续播进度、已看标记和播放次数都会清除，无法恢复。只影响你自己的记录。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress, watched markers and play counts for items played today are permanently cleared. Only your own records are affected."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fortschritt, Gesehen-Markierungen und Wiedergabezähler für heute abgespielte Einträge werden dauerhaft gelöscht. Nur deine eigenen Einträge sind betroffen."
