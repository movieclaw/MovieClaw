      "comment": "Network settings."
    },
    "settings.networkUi.envHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "环境变量使用服务器的 HTTPS_PROXY、HTTP_PROXY 或 ALL_PROXY；不使用时全部服务直连。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "环境变量使用服务器的 HTTPS_PROXY、HTTP_PROXY 或 ALL_PROXY；不使用时全部服务直连。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Environment variables use the server’s HTTPS_PROXY, HTTP_PROXY or ALL_PROXY. Otherwise all services connect directly."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Umgebungsvariablen nutzen die HTTPS_PROXY, HTTP_PROXY oder ALL_PROXY des Servers. Andernfalls verbinden sich alle Dienste direkt."
          }
        }
      },
      "comment": "Network settings."
    },
    "settings.networkUi.mirrorHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空使用默认地址。只填域名时会自动补全接口 /3 和图床 /t/p 路径。镜像可作为代理的替代方案；同时配置时会经代理访问镜像。公共镜像会接触你的 API Key，请选可信服务。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空使用默认地址。只填域名时会自动补全接口 /3 和图床 /t/p 路径。镜像可作为代理的替代方案；同时配置时会经代理访问镜像。公共镜像会接触你的 API Key，请选可信服务。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave blank for the defaults. A bare domain gets the /3 API path and /t/p image path added. Mirrors can replace a proxy; when both are set, mirrors are reached through the proxy. Public mirrors see your API key, so use services you trust."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass das Feld für die Standardwerte leer. Bei einer Domain ohne Pfad werden /3 für die API und /t/p für Bilder ergänzt. Spiegelserver können einen Proxy ersetzen. Wenn beides gesetzt ist, werden die Spiegelserver über den Proxy erreicht. Öffentliche Spiegelserver sehen deinen API-Schlüssel. Nutze deshalb nur Dienste, denen du vertraust."
          }
        }
      },
      "comment": "Network settings."
    },
    "settings.networkUi.addressInvalid": {
