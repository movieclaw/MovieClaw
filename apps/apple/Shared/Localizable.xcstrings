    "library.form.movie.defaults": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "实时监控目录变化、扫描后保留丢失记录、为未识别文件生成封面、在首页展示。第一个电影库自动成为默认库；刮削偏好建好后在「编辑库」里设。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "实时监控目录变化、扫描后保留丢失记录、为未识别文件生成封面、在首页展示。第一个电影库自动成为默认库；刮削偏好建好后在「编辑库」里设。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Monitor folder changes, keep missing file records, generate covers for unidentified files and show this library on the home page. The first movie library becomes the default. Set metadata preferences later in Edit library."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ordneränderungen überwachen, Einträge fehlender Dateien behalten, Cover für nicht identifizierte Dateien erzeugen und diese Mediathek auf der Startseite anzeigen. Die erste Film-Mediathek wird Standard. Metadaten-Einstellungen legst du später unter „Mediathek bearbeiten“ fest."
          }
        }
      }
    },
    "library.form.tv.defaults": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
