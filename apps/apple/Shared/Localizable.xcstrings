          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is equivalent to entering your username and password on this TV: it can access the same media libraries and record your viewing progress. Only approve the pairing code shown on the TV in front of you."
          }
        }
      }
    },
