    "subscription.rules.codecHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按家族选择，等价写法（如 x265 / HEVC）一并计入；不选 = 不限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "按家族选择，等价写法（如 x265 / HEVC）一并计入；不选 = 不限"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Select codec families, including equivalent names such as x265 / HEVC. Leave empty for any codec."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Codec-Familien auswählen, inklusive gleichwertiger Bezeichnungen wie x265 / HEVC. Leer lassen für jeden Codec."
          }
        }
      }
    },
    "subscription.rules.platform": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "流媒体平台"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "流媒体平台"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming platform"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Streaming-Plattform"
          }
        }
      }
    },
    "subscription.rules.platformHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下 = 只要，再点 = 排除，第三下取消。设了「只要」之后，识别不出平台的资源会被排除（与分辨率/编码口径一致）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下 = 只要，再点 = 排除，第三下取消。设了「只要」之后，识别不出平台的资源会被排除（与分辨率/编码口径一致）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to require, tap again to exclude, and a third time to clear. Requiring platforms also excludes releases with an unrecognized platform, as with resolution and codec restrictions."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal tippen zum Verlangen, erneut zum Ausschließen, ein drittes Mal zum Zurücksetzen. Werden Plattformen verlangt, sind – wie bei Auflösung und Codec – auch Releases mit unbekannter Plattform ausgeschlossen."
          }
        }
      }
    },
    "subscription.rules.hdrHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下 = 只要，再点 = 排除，第三下取消。\"SDR\" 指资源没标注任何 HDR 格式；\"DV P5\" 是只标了 DV、没有 HDR10 兼容层的杜比视界（转码会偏色），只能排除，点一下即排除；都不选 = 不限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下 = 只要，再点 = 排除，第三下取消。\"SDR\" 指资源没标注任何 HDR 格式；\"DV P5\" 是只标了 DV、没有 HDR10 兼容层的杜比视界（转码会偏色），只能排除，点一下即排除；都不选 = 不限"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap to require, tap again to exclude, and a third time to clear. “SDR” means no HDR format is declared. “DV P5” is Dolby Vision without an HDR10 fallback layer (colors shift when transcoded); it can only be excluded, so one tap excludes it. Leave empty for no restriction."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einmal tippen zum Verlangen, erneut zum Ausschließen, ein drittes Mal zum Zurücksetzen. „SDR“ heißt, dass kein HDR-Format angegeben ist. „DV P5“ ist Dolby Vision ohne HDR10-Fallback-Ebene (beim Transkodieren verschieben sich die Farben); es kann nur ausgeschlossen werden, ein Tippen schließt es also aus. Leer lassen für keine Einschränkung."
          }
        }
      }
    },
    "subscription.rules.groupsAllow": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
