    "settings.webhook.ui.jellyfinHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与 Jellyfin Webhook 插件同一套模板变量：下游文档里「贴进 Jellyfin 插件」的模板可直接贴到下方，实现免适配接入。此格式不签名，鉴权用附加请求头。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "与 Jellyfin Webhook 插件同一套模板变量：下游文档里「贴进 Jellyfin 插件」的模板可直接贴到下方，实现免适配接入。此格式不签名，鉴权用附加请求头。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses the same template variables as the Jellyfin Webhook plugin. Paste a template supplied for that plugin below to connect without adapting it. This format has no signature; use additional headers for authentication."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwendet dieselben Vorlagenvariablen wie das Jellyfin-Webhook-Plugin. Füge unten eine für dieses Plugin bereitgestellte Vorlage ein, um ohne Anpassung zu verbinden. Dieses Format hat keine Signatur; nutze zusätzliche Header zur Authentifizierung."
          }
        }
      }
    },
