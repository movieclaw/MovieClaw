    "settings.devices.labels.macBody": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "等同你在这台 Mac 上输入账号密码登录：它能看到你能看到的媒体库、记录你的观看进度。只批准你面前这台 Mac 上显示的配对码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "等同你在这台 Mac 上输入账号密码登录：它能看到你能看到的媒体库、记录你的观看进度。只批准你面前这台 Mac 上显示的配对码。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is equivalent to entering your username and password on this Mac: it can access the same media libraries and record your viewing progress. Only approve the pairing code shown on the Mac in front of you."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das entspricht der Eingabe von Benutzername und Passwort auf diesem Mac: Er kann auf dieselben Mediatheken zugreifen und deinen Wiedergabefortschritt speichern. Bestätige nur den Kopplungscode, der auf dem Mac vor dir angezeigt wird."
          }
        }
      }
    },
    "settings.devices.labels.adminTitle": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将获得：与你相同的完全权限"
          }
        },
        "zh-Hant": {
          "stringUnit": {
