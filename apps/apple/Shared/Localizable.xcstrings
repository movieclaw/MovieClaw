        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了这次请求（字段 %@%@）。如果填写没有问题，多半是 App 与服务器的版本不一致，请把两边都升级到最新版本后再试（错误码 422）"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "服务器拒绝了这次请求（字段 %@%@）。如果填写没有问题，多半是 App 与服务器的版本不一致，请把两边都升级到最新版本后再试（错误码 422）"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The server rejected the request (field %@%@). If your input is correct, update both the app and server to the latest version, then try again (error 422)."
