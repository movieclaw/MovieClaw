    "settings.phonePush.accountHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要一个 MovieClaw 账号（只有你需要，家人不用）。通知内容在这台服务器上加密，云端和推送中继都解不开。"
          }
        },
