    "settings.playback.remote.addressHint": {
      "extractionState": "manual",
      "generatesSymbol": true,
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留空使用每台转码器连接服务器时的地址。仅当反向代理改写 Host、导致转码器无法取源或回传时，才需要填写转码器可访问的 http(s) 地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "留空使用每台转码器连接服务器时的地址。仅当反向代理改写 Host、导致转码器无法取源或回传时，才需要填写转码器可访问的 http(s) 地址。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave blank to use the address each transcoder used to connect. Enter an http(s) address reachable by transcoders only if a reverse proxy rewrites Host and transcoders cannot fetch sources or upload results."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lass das Feld leer, damit jeder Transcoder die Adresse nutzt, über die er sich verbunden hat. Gib nur dann eine erreichbare HTTP- oder HTTPS-Adresse ein, wenn ein Reverse Proxy den Host umschreibt und Transcoder deshalb weder Quellen abrufen noch Ergebnisse hochladen können."
          }
        }
      },
      "comment": "Playback settings."
    },
