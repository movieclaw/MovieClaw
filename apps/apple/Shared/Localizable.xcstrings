        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "想让「%@」优先收这类作品：编辑它，补上「%@」条件（用「全选」也可以）——条件多的库优先命中；想维持现状则无需改动。"
          }
        },
        "zh-Hant": {
