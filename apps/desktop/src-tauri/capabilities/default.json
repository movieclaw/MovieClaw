{
  "identifier": "default",
  "description": "Default capability for MovieClaw Desktop",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-minimize",
    "core:window:allow-unminimize",
    "core:window:allow-maximize",
    "core:window:allow-unmaximize",
    "core:window:allow-close",
    "core:window:allow-toggle-maximize",
    "core:window:allow-is-maximized",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-show",
    "core:window:allow-hide",
    "core:window:allow-set-focus",
    "core:window:allow-start-dragging",
    "allow-save-server-url",
    "allow-load-server-url",
    "allow-clear-server-url",
    "allow-probe-server",
    "allow-check-for-updates",
    "allow-open-download-page",
    "allow-open-release-page",
    "allow-proxy-api",
    "allow-get-server-url",
    "allow-has-embedded-player",
    "allow-launch-embedded-player",
    "allow-resize-embedded-player",
    "allow-set-embedded-player-visible",
    "allow-stop-embedded-player",
    "allow-send-mpv-command-embedded",
    "allow-get-main-window-hwnd",
    "allow-discover-servers",
    "allow-cancel-proxy-request",
    "allow-complete-shutdown",
    "allow-get-app-version",
    "allow-get-about-info",
    "allow-get-embedded-player-status",
    "allow-native-auth-status",
    "allow-native-password-login",
    "allow-native-select-account",
    "allow-native-remove-account",
    "allow-native-logout",
    "allow-native-pair-begin",
    "allow-native-pair-poll",
    "allow-native-pair-cancel",
    "allow-grant-media-stream",
    "allow-release-media-stream",
    "allow-get-embedded-player-state",
    "allow-native-ready",
    "allow-renew-media-stream",
    "allow-begin-native-playback",
    "allow-update-native-playback",
    "allow-end-native-playback",
    "allow-set-native-picture-in-picture",
    "allow-download-update",
    "allow-cancel-update-download",
    "allow-install-downloaded-update",
    "allow-open-downloaded-update"
  ]
