<?xml version="1.0" encoding="utf-8"?>
<!-- 不备份、不迁移：令牌由本机 KeyStore 加密，换到别的设备也解不开，重新登录即可 -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
    </device-transfer>
</data-extraction-rules>
