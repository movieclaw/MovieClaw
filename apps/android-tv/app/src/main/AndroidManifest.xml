<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- 系统首页「继续观看」行（Watch Next） -->
    <uses-permission android:name="com.android.providers.tv.permission.WRITE_EPG_DATA" />

    <!-- 只给电视：没有触摸屏、要求 leanback -->
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".MovieClawApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:banner="@mipmap/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:largeHeap="true"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="true"
        android:supportsRtl="false"
        android:theme="@style/Theme.MovieClaw"
        tools:ignore="UnusedAttribute">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|screenSize|screenLayout|smallestScreenSize|orientation|uiMode"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- 普通启动器入口：**必须单独一个 filter**。国产电视（小米 MiTV 的
                 com.mitv.tvhome、海信/TCL/创维等自家桌面）用系统的 LauncherApps
                 列应用，只认 CATEGORY_LAUNCHER——只声明 LEANBACK_LAUNCHER 时应用能装
                 能跑，但桌面/应用列表里哪都找不到。两个类别写进同一个 filter 也不行：
                 类别匹配要求 intent 带上 filter 里写的全部类别，那样普通 LAUNCHER
                 intent 与 Google TV 桌面的 LEANBACK intent 会同时匹配不上。
                 Google 认证的 Android TV 桌面只索引 LEANBACK_LAUNCHER，多这一条不会
                 出现重复图标。 -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 「继续观看」与深链：movieclaw://play/<条目>?season=&episode=、movieclaw://item/<库>/<条目> -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="movieclaw" />
            </intent-filter>
        </activity>
        <provider
            android:name=".system.WatchNextImageProvider"
            android:authorities="${applicationId}.watchnext"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
