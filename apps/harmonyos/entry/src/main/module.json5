{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet",
      "2in1",
      "car",
      "tv"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    "routerMap": "$profile:router_map",
    /*
     * 沉浸光感应用级开关（ArkUI 沉浸式系统材质，targetSDK≥26 才生效）：
     * enable 后，未写自定义背景的弹窗类组件默认上材质——Toast/菜单→THICK、
     * 弹出框→ULTRA_THICK；写死过 backgroundColor 的弹窗不受影响（需显式
     * systemMaterial 才接管）。组件级设置优先于此开关。低于 26 的系统上
     * 该配置无效果，由 SpatialMaterial.supported 运行时兜底。
     */
    "metadata": [
      {
        "name": "ohos.arkui.UIMaterial.state",
        "value": "enable"
      }
    ],
    "requestPermissions": [
      {
        "name": "ohos.permission.INTERNET"
      },
      {
        /* 后台播放要它：配 AVSession 一起用，缺一个退后台就会被系统停掉 */
        "name": "ohos.permission.KEEP_BACKGROUND_RUNNING"
      },
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      {
        /* 批准 / 拒绝设备登录时震一下（同 iOS UINotificationFeedbackGenerator）；normal 级，声明即可 */
        "name": "ohos.permission.VIBRATE"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        /*
          长时任务必须在这里声明模式，否则 `startBackgroundRunning` 会报
          `9800005 Continuous Task verification failed. The bgMode is invalid.`
          ——错误只说「模式无效」，不告诉你「得先在清单里声明」，这一步是必需的。
        */
        "backgroundModes": ["audioPlayback", "dataTransfer"],
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "WorkNotifyExtensionAbility",
        /* 系统通知的延迟任务回调：退后台后由系统按活跃度拉起（最快 2 小时一次），跑在独立扩展进程 */
        "srcEntry": "./ets/notify/WorkNotifyExtensionAbility.ets",
        "type": "workScheduler",
        "exported": false
      },
      {
        "name": "EntryBackupAbility",
        "srcEntry": "./ets/entrybackupability/EntryBackupAbility.ets",
        "type": "backup",
        "exported": false,
        "metadata": [
          {
            "name": "ohos.extension.backup",
            "resource": "$profile:backup_config"
          }
        ],
      }
    ]
  }
}